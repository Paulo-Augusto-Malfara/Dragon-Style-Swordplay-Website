---
interface Props {
  id?: string;
  nome: string;
  img: string;
  imgAlt: string;
  comprimento: string;
  empunhadaCom: string;
  classes: string;
  construcao: string[];
  descricao: string[];
}
const { id, nome, img, imgAlt, comprimento, empunhadaCom, classes, construcao, descricao } = Astro.props;
---

<div id={id} class="arma-card">
  <h3 class="arma-nome">{nome}</h3>
  <div class="arma-display">
    <img class="arma-img" src={img} alt={imgAlt} />
    <ul>
      <li class="arma-info">Características</li>
      <ul class="arma-specs">
        <li>Comprimento: {comprimento};</li>
        <li>Empunhada com: {empunhadaCom};</li>
        <li set:html={classes} />
        <li>
          Construção do equipamento:
          {construcao.map((linha) => (
            <>
              <br />- {linha}
            </>
          ))}
        </li>
      </ul>
    </ul>
  </div>
  <br />
  {descricao.map((paragrafo) => (
    <>
      <p set:html={paragrafo} />
      <br />
    </>
  ))}
</div>
