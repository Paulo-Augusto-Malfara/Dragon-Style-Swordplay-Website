---
import { corDaFaixa } from "../lib/faixa";

/**
 * Uma colocação do ranking.
 *
 * `metricas` é lista aberta em vez de campos fixos porque o Ranking Geral mede
 * quatro coisas e o Ranking por Classe mede duas. Schema fixo obrigaria a
 * inventar coluna vazia para metade dos usos.
 */
export type Colocacao = {
  /**
   * Opcional: o Mural de Doações usa esta mesma lista e ali não há colocação
   * nenhuma, é histórico. Sem o número a linha perde a primeira coluna e o
   * resto continua igual, que é o ponto de reusar em vez de copiar a aparência.
   */
  posicao?: number;
  /** Só pro navegador achar a sua linha. Ver o <script> no fim do arquivo. */
  idMembro: number;
  nome: string;
  fotoUrl?: string | null;
  nomeFaixa?: string | null;
  metricas: { rotulo: string; valor: number | string }[];
};

interface Props {
  itens: Colocacao[];
  /** Quantas métricas cabem lado a lado no desktop. Mantém as colunas retas. */
  colunas?: number;
}

const { itens, colunas = 4 } = Astro.props;
const comPosicao = itens.some((i) => i.posicao != null);
---

{/*
  É <ol>, não <table>. Um ranking é literalmente uma lista ordenada, e a
  tabela de seis colunas que estava aqui só cabia no celular com rolagem
  lateral: para ver os pontos de honra do primeiro colocado era preciso
  arrastar a tabela e perder o nome de vista. Aqui as métricas quebram para
  a segunda linha sozinhas quando falta largura, e nada sai da tela.
*/}
<ol class:list={["rk", !comPosicao && "rk--sem-pos"]} style={`--rk-colunas:${colunas}`}>
  {
    itens.map((item) => (
      <li
        class:list={[
          "rk-item",
          item.posicao != null && item.posicao <= 3 && `rk-podio rk-${item.posicao}`,
        ]}
        data-membro={item.idMembro}
      >
        {item.posicao != null && <span class="rk-pos">{item.posicao}</span>}

        <span class="rk-quem">
          <span class="rk-avatar">
            {item.fotoUrl ? (
              <img src={item.fotoUrl} alt="" loading="lazy" />
            ) : (
              item.nome.charAt(0).toUpperCase()
            )}
          </span>
          <span class="rk-nome">{item.nome}</span>
          {corDaFaixa(item.nomeFaixa) && (
            <span
              class="rk-faixa"
              style={`--faixa:${corDaFaixa(item.nomeFaixa)}`}
              title={`Faixa ${item.nomeFaixa}`}
            >
              <span class="sr-only">Faixa {item.nomeFaixa}</span>
            </span>
          )}
        </span>

        <span class="rk-metricas">
          {item.metricas.map((m) => (
            <span class="rk-metrica">
              <span class="rk-valor">{m.valor}</span>
              <span class="rk-rotulo">{m.rotulo}</span>
            </span>
          ))}
        </span>
      </li>
    ))
  }
</ol>

<style>
  .rk {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .rk-item {
    display: grid;
    /* Celular: posição e pessoa na primeira linha, métricas na segunda,
       alinhadas ao nome. Nada rola de lado. */
    grid-template-columns: 34px 1fr;
    align-items: center;
    gap: 4px 12px;
    padding: 12px 14px;
    border: 1px solid var(--ds-line);
    border-radius: 12px;
    background: var(--ds-surface);
  }

  /* Sem colocação a primeira coluna não existe, e as métricas passam a começar
     na coluna 1. Sem isso elas ficariam na 2, que aqui não é coluna nenhuma. */
  .rk--sem-pos .rk-item {
    grid-template-columns: 1fr;
  }

  .rk--sem-pos .rk-metricas {
    grid-column: 1;
  }

  .rk-pos {
    font-family: var(--ds-font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ds-text-4);
    text-align: center;
  }

  /* O pódio é a única hierarquia visual da lista. Ouro, prata e bronze são
     lidos antes de qualquer número, e é isso que se procura ao abrir a
     página. */
  .rk-podio .rk-pos {
    font-size: 1.15rem;
  }

  /* O pódio é só a cor do número. A moldura dourada que o primeiro lugar tinha
     saiu de propósito: a linha inteira acesa concorria com o anel de "você",
     que é o destaque que importa pra quem está lendo a própria colocação. */
  .rk-1 .rk-pos {
    color: var(--ds-gold-light);
  }

  .rk-2 .rk-pos {
    color: var(--ds-prata);
  }

  .rk-3 .rk-pos {
    color: var(--ds-bronze);
  }

  .rk-quem {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
  }

  .rk-avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--ds-line-strong);
    background: var(--ds-bg-alt);
    font-family: var(--ds-font-display);
    font-size: 0.85rem;
    color: var(--ds-text-3);
    overflow: hidden;
  }

  .rk-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rk-nome {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.92rem;
  }

  /* Traço de cor, não pílula: a faixa é um atributo da pessoa e não deve
     competir de tamanho com o nome dela. */
  .rk-faixa {
    flex: none;
    width: 22px;
    height: 8px;
    border-radius: 2px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: var(--faixa);
  }

  .rk-metricas {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }

  .rk-metrica {
    display: flex;
    align-items: baseline;
    gap: 5px;
  }

  .rk-valor {
    font-family: var(--ds-font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ds-gold);
  }

  .rk-rotulo {
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--ds-text-5);
  }

  /* Desktop: tudo numa linha só, com as métricas em colunas de largura igual
     para os números baterem verticalmente de uma colocação para a outra. */
  @media (min-width: 720px) {
    .rk-item {
      grid-template-columns: 40px minmax(0, 1fr) auto;
      padding: 13px 18px;
    }

    .rk--sem-pos .rk-item {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .rk-metricas {
      grid-column: auto;
      display: grid;
      grid-template-columns: repeat(var(--rk-colunas), minmax(72px, auto));
      gap: 0 22px;
    }

    .rk-metrica {
      flex-direction: column;
      align-items: center;
      gap: 1px;
    }

    .rk-valor {
      font-size: 1.15rem;
    }
  }

  /* "Esta linha é você".
   *
   * Anel por fora, e não troca de borda ou de fundo: é o único realce de linha
   * inteira da lista, então você se acha de longe sem nada mais competindo. */
  .rk-eu {
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.22);
  }

  /* .rk-eu pode ficar escopado porque o <li> que recebe a classe já nasce
     neste template, e já carrega o atributo de escopo do Astro. A pílula não:
     ela é criada por JS, ver o bloco is:global logo abaixo. */
</style>

{/*
  is:global é obrigatório aqui, não preferência, pelo mesmo motivo da busca: o
  Astro escopa estilo carimbando um atributo nos elementos do TEMPLATE, e a
  pílula nasce de document.createElement em tempo de execução, sem carimbo
  nenhum. Escopada, ela sairia sem estilo e o defeito seria só visual, do tipo
  que passa despercebido em revisão de código.
*/}
<style is:global>
  /* A palavra existe porque cor sozinha não diz "você", e porque quem usa
     leitor de tela também precisa da informação. */
  .rk-eu-marca {
    flex: none;
    padding: 2px 7px;
    border-radius: 999px;
    border: 1px solid var(--ds-line-strong);
    background: var(--ds-bg-alt);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ds-text-3);
  }
</style>

<script>
  /* O destaque da sua linha é aceso pelo navegador, nunca pelo servidor.
   *
   * O HTML do ranking fica 60s no cache de borda da Vercel e é entregue igual
   * pra todo visitante. Se o destaque viesse pronto do servidor, a borda
   * mostraria a linha de um membro marcada como sendo de outro. Ver a regra de
   * Cache-Control no vercel.json e o teste que guarda isso.
   *
   * Quem descobre o id é o AuthLink, que já roda em toda página e já faz essa
   * consulta pro avatar do cabeçalho. Aqui só se escuta o resultado, pra não
   * existirem duas consultas perguntando a mesma coisa.
   */
  let meuId: string | null = null;

  function marcar() {
    // O ClientRouter troca os atributos do <html> pelos da página nova, que vem
    // sem data-membro: quem recarimba a cada navegação é o AuthLink. O valor
    // fica guardado aqui depois da primeira vez, então navegar de volta acende
    // na hora, sem esperar a consulta de novo.
    meuId = document.documentElement.dataset.membro || meuId;
    if (!meuId) return;

    for (const item of document.querySelectorAll<HTMLElement>(".rk-item")) {
      // Comparado em JS em vez de interpolado num seletor: id não vem daqui,
      // mas seletor montado com string é o tipo de coisa que envelhece mal.
      if (item.dataset.membro !== meuId) continue;
      if (item.querySelector(".rk-eu-marca")) continue; // já marcada

      item.classList.add("rk-eu");
      const marca = document.createElement("span");
      marca.className = "rk-eu-marca";
      marca.textContent = "você";
      item.querySelector(".rk-quem")?.append(marca);
    }
  }

  marcar(); // caso o AuthLink já tenha resolvido antes deste script rodar
  document.addEventListener("ds:membro", marcar);
  document.addEventListener("astro:page-load", marcar);
</script>
