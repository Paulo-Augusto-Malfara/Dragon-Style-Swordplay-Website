---
import { corDaFaixa } from "../lib/faixa";

/**
 * Uma colocação do ranking.
 *
 * `metricas` é lista aberta em vez de campos fixos porque o Ranking Geral mede
 * quatro coisas e o Ranking por Classe mede duas. Schema fixo obrigaria a
 * inventar coluna vazia para metade dos usos.
 */
export type Colocacao = {
  posicao: number;
  nome: string;
  fotoUrl?: string | null;
  nomeFaixa?: string | null;
  metricas: { rotulo: string; valor: number | string }[];
};

interface Props {
  itens: Colocacao[];
  /** Quantas métricas cabem lado a lado no desktop. Mantém as colunas retas. */
  colunas?: number;
}

const { itens, colunas = 4 } = Astro.props;
---

{/*
  É <ol>, não <table>. Um ranking é literalmente uma lista ordenada, e a
  tabela de seis colunas que estava aqui só cabia no celular com rolagem
  lateral: para ver os pontos de honra do primeiro colocado era preciso
  arrastar a tabela e perder o nome de vista. Aqui as métricas quebram para
  a segunda linha sozinhas quando falta largura, e nada sai da tela.
*/}
<ol class="rk" style={`--rk-colunas:${colunas}`}>
  {
    itens.map((item) => (
      <li class:list={["rk-item", item.posicao <= 3 && `rk-podio rk-${item.posicao}`]}>
        <span class="rk-pos">{item.posicao}</span>

        <span class="rk-quem">
          <span class="rk-avatar">
            {item.fotoUrl ? (
              <img src={item.fotoUrl} alt="" loading="lazy" />
            ) : (
              item.nome.charAt(0).toUpperCase()
            )}
          </span>
          <span class="rk-nome">{item.nome}</span>
          {corDaFaixa(item.nomeFaixa) && (
            <span
              class="rk-faixa"
              style={`--faixa:${corDaFaixa(item.nomeFaixa)}`}
              title={`Faixa ${item.nomeFaixa}`}
            >
              <span class="sr-only">Faixa {item.nomeFaixa}</span>
            </span>
          )}
        </span>

        <span class="rk-metricas">
          {item.metricas.map((m) => (
            <span class="rk-metrica">
              <span class="rk-valor">{m.valor}</span>
              <span class="rk-rotulo">{m.rotulo}</span>
            </span>
          ))}
        </span>
      </li>
    ))
  }
</ol>

<style>
  .rk {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .rk-item {
    display: grid;
    /* Celular: posição e pessoa na primeira linha, métricas na segunda,
       alinhadas ao nome. Nada rola de lado. */
    grid-template-columns: 34px 1fr;
    align-items: center;
    gap: 4px 12px;
    padding: 12px 14px;
    border: 1px solid var(--ds-line);
    border-radius: 12px;
    background: var(--ds-surface);
  }

  .rk-pos {
    font-family: var(--ds-font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ds-text-4);
    text-align: center;
  }

  /* O pódio é a única hierarquia visual da lista. Ouro, prata e bronze são
     lidos antes de qualquer número, e é isso que se procura ao abrir a
     página. */
  .rk-podio .rk-pos {
    font-size: 1.15rem;
  }

  .rk-1 {
    border-color: var(--ds-gold-dim);
    background: var(--ds-gold-wash);
  }

  .rk-1 .rk-pos {
    color: var(--ds-gold-light);
  }

  .rk-2 .rk-pos {
    color: #c6ccd2;
  }

  .rk-3 .rk-pos {
    color: #c08552;
  }

  .rk-quem {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
  }

  .rk-avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--ds-line-strong);
    background: var(--ds-bg-alt);
    font-family: var(--ds-font-display);
    font-size: 0.85rem;
    color: var(--ds-text-3);
    overflow: hidden;
  }

  .rk-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rk-1 .rk-avatar {
    border-color: var(--ds-gold);
  }

  .rk-nome {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.92rem;
  }

  /* Traço de cor, não pílula: a faixa é um atributo da pessoa e não deve
     competir de tamanho com o nome dela. */
  .rk-faixa {
    flex: none;
    width: 22px;
    height: 8px;
    border-radius: 2px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: var(--faixa);
  }

  .rk-metricas {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }

  .rk-metrica {
    display: flex;
    align-items: baseline;
    gap: 5px;
  }

  .rk-valor {
    font-family: var(--ds-font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ds-gold);
  }

  .rk-rotulo {
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--ds-text-5);
  }

  /* Desktop: tudo numa linha só, com as métricas em colunas de largura igual
     para os números baterem verticalmente de uma colocação para a outra. */
  @media (min-width: 720px) {
    .rk-item {
      grid-template-columns: 40px minmax(0, 1fr) auto;
      padding: 13px 18px;
    }

    .rk-metricas {
      grid-column: auto;
      display: grid;
      grid-template-columns: repeat(var(--rk-colunas), minmax(72px, auto));
      gap: 0 22px;
    }

    .rk-metrica {
      flex-direction: column;
      align-items: center;
      gap: 1px;
    }

    .rk-valor {
      font-size: 1.15rem;
    }
  }
</style>
