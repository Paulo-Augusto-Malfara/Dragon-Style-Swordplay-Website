    </div>
    <div class="footer-col">
      <h4>Sobre</h4>
      <ul>
        <li><a href="/quem-somos">Quem Somos</a></li>
        <li><a href="/o-que-e-swordplay">O que é Swordplay</a></li>
        <li><a href="/como-participar">Como Participar</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Regras</h4>
      <ul>
        <li><a href="/regras-de-combate">Regras de Combate</a></li>
        <li><a href="/codigo-de-conduta">Código de Conduta</a></li>
        <li><a href="/equipamentos">Equipamentos</a></li>
      </ul>
