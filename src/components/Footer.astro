      <ul>
        <li><a href="/administracao">Administração</a></li>
        <li><a href="/doacoes">Doações</a></li>
        <li><a href="/mural-de-doacoes">Mural de Doações</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-socials">
    <a href="https://www.facebook.com/groups/227828760657044" target="_blank" aria-label="Facebook">
      <Icon name="facebook" />
    </a>
    <a href="https://instagram.com/ds.swordplay?igshid=YmMyMTA2M2Y=" target="_blank" aria-label="Instagram">
      <Icon name="instagram" />
