---
/**
 * IA de 2026: 4 grupos, 19 entradas. Antes eram 5 grupos e 39 itens, com as 10
 * classes e as 6 categorias de arma listadas uma a uma no menu.
 *
 * Regra da estrutura: o menu leva a catálogos, e a página de detalhe é
 * alcançada pelo catálogo, que é onde dá pra comparar uma com a outra. Por isso
 * "Classes" aponta pro resumo (que já linkava as 10) e "Equipamentos" pra
 * introdução (que passou a linkar as 6 categorias via CatalogoLinks).
 *
 * Doações, Mural de Doações e Administração saíram daqui pro rodapé
 * institucional: são institucionais e não competem pela mesma atenção que
 * ranking e mural.
 *
 * Conquistas e Vestimentas existem como rota mas o conteúdo ainda não é real,
 * então continuam fora do menu de propósito.
 */
import { menu } from "../lib/navegacao";

const atual = Astro.url.pathname.replace(/\/$/, "") || "/";

/* A página de detalhe marca a lista de onde se chega nela: /novidades/<slug>
   acende "Novidades", /torneios/12 acende "Torneios". Antes era igualdade
   exata, e abrir um detalhe apagava o menu inteiro, tirando da pessoa a única
   pista de onde ela está. O "/" fica de fora do prefixo, senão a Início
   acenderia em toda página do site. */
const naSecao = (href: string) =>
  atual === href || (href !== "/" && atual.startsWith(`${href}/`));
---

<section>
  <nav class="nav">
    <div class="container">
      <input
        type="checkbox"
        id="nav-toggle"
        class="nav-toggle-checkbox"
        aria-controls="menu-main"
        aria-expanded="false"
      />
      <label for="nav-toggle" class="toggle-button">MENU</label>
      <ul class="menu-main" id="menu-main">
        {
          menu.map((group) => (
            <li>
              <a class="menu-a">{group.label}</a>
              <div class="menu-sub">
                <ul>
                  {group.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        aria-current={naSecao(item.href) ? "page" : undefined}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</section>

<script>
  // ponytail: only syncs aria-expanded for screen readers - the checkbox still
  // drives the show/hide via CSS, no behavior change for mouse/touch users
  function sincronizar(e: Event) {
    const checkbox = e.currentTarget as HTMLInputElement;
    checkbox.setAttribute("aria-expanded", String(checkbox.checked));
  }

  // O ClientRouter troca o #nav-toggle a cada navegação, então religa a cada
  // página. Chamado direto também porque /admin e /auth não têm ClientRouter,
  // e lá o astro:page-load nunca dispara. Rodar duas vezes na primeira carga
  // não duplica nada: o navegador ignora addEventListener com a mesma função.
  function ligar() {
    document.getElementById("nav-toggle")?.addEventListener("change", sincronizar);
  }

  ligar();
  document.addEventListener("astro:page-load", ligar);
</script>
