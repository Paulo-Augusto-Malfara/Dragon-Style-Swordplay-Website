---
/**
 * O conteúdo de uma classe: a ficha do topo e o corpo vindo do .mdx.
 *
 * Vive num componente porque duas telas mostram exatamente isto: a página da
 * classe (/espadachim) e a janela que abre do catálogo em /resumo-das-classes.
 * O estilo do corpo tem que ficar num lugar só, já que o conteúdo vem do .mdx e
 * não recebe o atributo de escopo do Astro.
 *
 * A ficha sai do frontmatter, o mesmo dado que monta o card do catálogo, então
 * card, janela e página nunca discordam.
 */
import { getEntry, render } from "astro:content";

interface Props {
  slug: string;
}
const { slug } = Astro.props;

const entry = await getEntry("classes", slug);
if (!entry) throw new Error(`Classe sem conteúdo em src/content/classes: ${slug}`);
const { Content } = await render(entry);
const c = entry.data;
---

<section class="classe-ficha" aria-label={`Resumo da classe ${c.title}`}>
  <img src={c.image} alt={c.imageAlt} />
  <dl>
    <div>
      <dt>Armamento</dt>
      <dd>{c.armamento}</dd>
    </div>
    <div>
      <dt>Alcance</dt>
      <dd>{c.alcance}</dd>
    </div>
    <div>
      <dt>Dificuldade</dt>
      <dd>{c.dificuldade}</dd>
    </div>
  </dl>
  {c.selo && <p class="classe-selo"><span>{c.selo}</span></p>}
</section>

<div class="classe-corpo">
  <Content />
</div>

<style>
  /* ======== FICHA DO TOPO ======== */

  .classe-ficha {
    display: grid;
    grid-template-columns: 150px 1fr;
    align-items: center;
    gap: 18px;
    margin-bottom: 22px;
    padding: 16px;
    border: 1px solid var(--ds-line);
    border-radius: 12px;
    background: var(--ds-surface);
  }

  .classe-ficha > img {
    width: 100%;
    max-height: 150px;
    object-fit: contain;
  }

  .classe-ficha dl {
    margin: 0;
  }

  .classe-ficha dl > div {
    display: grid;
    grid-template-columns: 118px 1fr;
    gap: 10px;
    padding: 7px 0;
    border-bottom: 1px solid var(--ds-line);
  }

  .classe-ficha dl > div:last-child {
    border-bottom: none;
  }

  .classe-ficha dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ds-text-4);
  }

  .classe-ficha dd {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.45;
    color: var(--ds-text-1);
  }

  /* O selo encolhe com o próprio texto: o <p> é só o alinhamento da linha. */
  .classe-selo {
    grid-column: 1 / -1;
    width: 100%;
    margin: 0;
  }

  .classe-selo > span {
    display: inline-block;
    padding: 4px 11px;
    border: 1px solid var(--ds-gold-dim);
    border-radius: 999px;
    background: var(--ds-gold-wash);
    font-size: 0.72rem;
    color: var(--ds-gold-light);
  }

  /* ======== CORPO VINDO DO .MDX ======== */

  /* O conteúdo do .mdx não recebe o atributo de escopo, por isso :global(). */
  .classe-corpo :global(h2) {
    margin: 26px 0 10px;
    font-size: 1.22rem;
  }

  .classe-corpo :global(p) {
    width: 100%;
    margin: 0 0 0.7em;
    font-size: 0.95rem;
  }

  .classe-corpo :global(.lista-comum) {
    width: 100%;
    margin: 0 0 0.4em;
    font-size: 0.95rem;
  }

  .classe-corpo :global(.lista-comum > li) {
    margin-left: 1.1rem;
    margin-bottom: 0.55em;
  }

  /* ======== BLOCOS RECOLHIDOS ======== */

  .classe-corpo :global(.classe-bloco) {
    margin-top: 14px;
    border: 1px solid var(--ds-line);
    border-radius: 10px;
    background: var(--ds-surface);
  }

  .classe-corpo :global(.classe-bloco > summary) {
    padding: 12px 16px;
    font-family: var(--ds-font-display);
    color: var(--ds-gold-light);
    cursor: pointer;
  }

  .classe-corpo :global(.classe-bloco[open] > summary) {
    border-bottom: 1px solid var(--ds-line);
  }

  .classe-corpo :global(.classe-bloco > p),
  .classe-corpo :global(.classe-bloco > ul) {
    margin: 12px 16px;
  }

  @media (max-width: 560px) {
    .classe-ficha {
      grid-template-columns: 1fr;
      gap: 12px;
      text-align: center;
    }

    .classe-ficha > img {
      max-height: 130px;
    }

    .classe-ficha dl > div {
      grid-template-columns: 1fr;
      gap: 2px;
      text-align: left;
    }
  }
</style>
