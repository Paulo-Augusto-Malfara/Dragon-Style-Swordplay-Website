---
import Icon from "./Icon.astro";

interface Props {
  prev?: { href: string; label: string };
  next?: { href: string; label: string };
}
const { prev, next } = Astro.props;
---

<section id="pagina-anterior-e-seguinte">
  <div class:list={["pagina-anterior", { "primeira-pagina-anterior": !prev }]}>
    {
      prev && (
        <>
          <Icon name="chevron-back" />
          <a class="links-de-texto" href={prev.href}>
            {prev.label}
          </a>
        </>
      )
    }
  </div>
  <div class="pagina-seguinte">
    {
      next && (
        <>
          <a class="links-de-texto" href={next.href}>
            {next.label}
          </a>
          <Icon name="chevron-forward" />
        </>
      )
    }
  </div>
</section>
