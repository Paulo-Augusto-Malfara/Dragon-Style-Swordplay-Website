---
/**
 * Página completa de uma classe.
 *
 * As dez páginas de classe eram o mesmo arquivo dez vezes, mudando só o slug.
 * O conteúdo em si (ficha e corpo) mora em ClasseFicha, porque a janela do
 * catálogo mostra exatamente o mesmo; aqui sobra o que é da página: o cabeçalho
 * e o rodapé de links.
 */
import { getEntry } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import ClasseFicha from "./ClasseFicha.astro";

interface Props {
  slug: string;
}
const { slug } = Astro.props;

const entry = await getEntry("classes", slug);
if (!entry) throw new Error(`Classe sem conteúdo em src/content/classes: ${slug}`);
const c = entry.data;
---

<PageLayout
  title={c.title}
  description={`${c.title} no Dragon Style: ${c.resumo}`}
  resumo={c.resumo}
>
  <ClasseFicha slug={slug} />

  <p class="classe-rodape">
    Medidas e formatos de cada arma estão em <a class="links-de-texto" href="/equipamentos"
      >Equipamentos</a
    >. As regras do sistema de níveis estão em <a
      class="links-de-texto"
      href="/como-funciona">Sistema de Classes</a
    >.
  </p>
</PageLayout>

<style>
  .classe-rodape {
    width: 100%;
    margin: 26px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--ds-line);
    font-size: 0.88rem;
    color: var(--ds-text-4);
  }
</style>
