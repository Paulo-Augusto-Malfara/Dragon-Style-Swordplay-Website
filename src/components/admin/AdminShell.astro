---
/**
 * Casca das páginas de admin.
 *
 * Existia um problema de navegação que nenhuma página resolvia sozinha: o menu
 * lateral e o dock do celular são os públicos, com Classes e Equipamentos. Uma
 * vez dentro do admin, pular de Treinos pra Membros exigia voltar pro hub
 * primeiro, toda vez. Aqui a barra de seções do admin acompanha a pessoa.
 *
 * As páginas de admin também eram as únicas que ainda usavam BaseLayout direto,
 * então não tinham nem medida de linha nem rótulo dizendo onde você está.
 *
 * A lista de seções vive aqui e não em cada página porque as permissões são as
 * mesmas nas cinco, e duplicar a condição é como uma delas fica pra trás.
 *
 * A barra ficou grudada no topo: dentro de um treino aberto a lista de
 * presenças passa de trinta linhas, e trocar de seção exigia rolar tudo de
 * volta. Mesmo tratamento que a barra de classes do ranking já tinha.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  title: string;
  /** Uma frase de contexto abaixo do título. */
  resumo?: string;
  /** Link de volta, pra quem está numa página de detalhe. */
  voltar?: { href: string; label: string };
}
const { title, resumo, voltar } = Astro.props;

const { membro } = Astro.locals;

const secoes = [
  { href: "/admin/membros", label: "Membros", ver: true },
  { href: "/admin/treinos", label: "Treinos", ver: true },
  { href: "/admin/eventos", label: "Eventos", ver: true },
  { href: "/admin/agenda", label: "Agenda", ver: membro.isOrganizador },
  { href: "/admin/doacoes", label: "Doações", ver: membro.isAdminSistema },
  { href: "/admin/posts", label: "Novidades", ver: membro.isOrganizador },
  { href: "/admin/modalidades", label: "Modalidades", ver: membro.isOrganizador },
].filter((s) => s.ver);

// Marca a seção mesmo estando numa página filha, tipo /admin/treinos/12.
const atual = Astro.url.pathname.replace(/\/$/, "");
const naSecao = (href: string) => atual === href || atual.startsWith(href + "/");
---

<BaseLayout title={`Admin: ${title}`}>
  <div class="pagina">
    <nav class="admin-topo" aria-label="Seções do painel">
      <a href="/admin" class="admin-marca" aria-current={atual === "/admin" ? "page" : undefined}>
        Painel
      </a>
      <div class="admin-secoes">
        {
          secoes.map((s) => (
            <a href={s.href} class="admin-secao" aria-current={naSecao(s.href) ? "page" : undefined}>
              {s.label}
            </a>
          ))
        }
      </div>
    </nav>

    <header class="pagina-cab admin-cab">
      {
        voltar && (
          <a class="admin-voltar" href={voltar.href}>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
              <path d="M15.5 4 7 12l8.5 8 1.4-1.4L9.8 12l7.1-6.6z" />
            </svg>
            {voltar.label}
          </a>
        )
      }
      <h1>{title}</h1>
      {resumo && <p class="pagina-resumo">{resumo}</p>}
    </header>

    <slot />
  </div>
</BaseLayout>

<style>
  /* Grudada abaixo do cabeçalho do site. O fundo é opaco de propósito: com
     fundo translúcido a lista passa por baixo e as duas se leem juntas. */
  .admin-topo {
    position: sticky;
    top: var(--ds-header-h);
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    padding: 10px 0;
    background: var(--ds-bg);
    border-bottom: 1px solid var(--ds-line);
  }

  .admin-marca {
    flex: none;
    font-family: var(--ds-font-display);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ds-gold);
    text-decoration: none;
  }

  .admin-marca[aria-current="page"] {
    color: var(--ds-gold-light);
  }

  /* Rola de lado no celular. Com wrap, cinco seções viravam duas linhas e
     empurravam o título pra fora da primeira tela. */
  .admin-secoes {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    /* Respiro pro anel de foco não ser cortado pelo overflow. */
    padding: 3px 0;
  }

  .admin-secoes::-webkit-scrollbar {
    display: none;
  }

  .admin-secao {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 14px;
    border: 1px solid var(--ds-line-strong);
    border-radius: 999px;
    font-size: 0.84rem;
    white-space: nowrap;
    color: var(--ds-text-3);
    text-decoration: none;
    transition:
      color 0.15s,
      border-color 0.15s,
      background 0.15s;
  }

  .admin-secao:hover {
    color: var(--ds-text-1);
    border-color: var(--ds-gold-dim);
  }

  .admin-secao[aria-current="page"] {
    background: var(--ds-gold-wash);
    border-color: var(--ds-gold-dim);
    color: var(--ds-gold-light);
  }

  /* O cabeçalho da página de admin é mais apertado que o das páginas de
     conteúdo: aqui embaixo dele vem trabalho, não leitura. */
  .admin-cab {
    margin-bottom: 1.2rem;
    padding-bottom: 0.9rem;
  }

  .admin-voltar {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 8px;
    font-size: 0.82rem;
    color: var(--ds-text-3);
    text-decoration: none;
  }

  .admin-voltar:hover {
    color: var(--ds-gold-light);
  }

  @media (max-width: 560px) {
    .admin-topo {
      top: 0;
    }
  }
</style>
