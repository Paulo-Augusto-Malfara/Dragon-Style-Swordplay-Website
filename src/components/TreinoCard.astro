---
interface Registro {
  id_treino: number;
  data_treino: string;
  nome: string;
  foto_url: string | null;
  nome_classe: string;
  nivel_geral: number;
  subiu_nivel_geral: boolean;
  subida_nivel_geral: number;
  nivel_classe: number;
  subiu_nivel_classe: boolean;
}

interface Props {
  idTreino: number;
  dataTreino: string;
  attendees: Registro[];
}

const { idTreino, dataTreino, attendees } = Astro.props;
const data = new Date(dataTreino + "T00:00:00");
const dataCurta = data.toLocaleDateString("pt-BR", { day: "2-digit", month: "2-digit" });
const ano = data.getFullYear();
const subiram = attendees.filter((r) => r.subiu_nivel_geral).length;
---

{/*
  Linha fechada, não card. São 86 treinos: com o cartão de antes, cada um
  gastava 118px de altura pra dizer três coisas, e chegar no treino de junho
  exigia rolar meia dúzia de telas. Aqui a data vem primeiro, porque é por data
  que alguém procura um treino, e o número fica de apoio.
*/}
<details class="tr-item">
  <summary>
    <span class="tr-data">
      <strong>{dataCurta}</strong>
      <small>{ano}</small>
    </span>
    <span class="tr-id">Treino {idTreino}</span>
    <span class="tr-conta">
      {attendees.length}
      {attendees.length === 1 ? " presente" : " presentes"}
      {subiram > 0 && (
        <span class="tr-subiu">
          {subiram === 1 ? "1 subiu de nível" : `${subiram} subiram de nível`}
        </span>
      )}
    </span>
  </summary>

  {/*
    Dentro, uma lista por pessoa em vez da tabela de 4 colunas. Quem abre um
    treino quer ver quem estava e quem subiu, e no celular a tabela obrigava a
    arrastar de lado pra chegar na coluna que responde isso.
  */}
  <ul class="tr-presentes">
    {/*
      Os dois números só se explicam uma vez, no alto da lista: repetir "geral"
      e "classe" em cada linha seria dizer vinte vezes o que muda zero vez.
    */}
    <li class="tr-cab">
      <span class="tr-cab-rotulo">Nível</span>
      <span class="tr-niveis">
        <span class="tr-cab-col">Geral</span>
        <span class="tr-cab-col">Classe</span>
      </span>
    </li>
    {attendees.map((r) => (
      <li>
        <span class="tr-avatar">
          {r.foto_url ? <img src={r.foto_url} alt="" loading="lazy" /> : r.nome.charAt(0).toUpperCase()}
        </span>
        <span class="tr-nome">
          {r.nome}
          <small>{r.nome_classe}</small>
        </span>
        <span class="tr-niveis">
          <span class:list={["tr-nivel", r.subiu_nivel_geral && "subiu"]}>
            {r.nivel_geral}
            {r.subiu_nivel_geral && <span class="tr-seta">{"▲".repeat(r.subida_nivel_geral)}</span>}
          </span>
          <span class:list={["tr-nivel", "tr-nivel--classe", r.subiu_nivel_classe && "subiu"]}>
            {r.nivel_classe}
            {r.subiu_nivel_classe && <span class="tr-seta">▲</span>}
          </span>
        </span>
      </li>
    ))}
  </ul>
</details>

<style>
  .tr-item {
    border: 1px solid var(--ds-line);
    border-radius: 12px;
    background: var(--ds-surface);
  }

  .tr-item[open] {
    border-color: var(--ds-gold-dim);
  }

  .tr-item summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    cursor: pointer;
    list-style: none;
  }

  .tr-item summary::-webkit-details-marker {
    display: none;
  }

  .tr-item summary:hover .tr-id {
    color: var(--ds-gold-light);
  }

  .tr-data {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.1;
  }

  .tr-data strong {
    font-family: var(--ds-font-display);
    font-size: 0.98rem;
    color: var(--ds-gold);
  }

  .tr-data small {
    font-size: 0.62rem;
    color: var(--ds-text-5);
  }

  .tr-id {
    flex: 1;
    min-width: 0;
    font-size: 0.9rem;
    color: var(--ds-text-2);
  }

  .tr-conta {
    flex: none;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    color: var(--ds-text-4);
  }

  /* Quem subiu de nível é a única coisa que se comemora num treino, então é a
     única coisa colorida da linha fechada. */
  .tr-subiu {
    padding: 2px 7px;
    border: 1px solid var(--ds-gold-dim);
    border-radius: 999px;
    background: var(--ds-gold-wash);
    color: var(--ds-gold-light);
    white-space: nowrap;
  }

  .tr-presentes {
    margin: 0;
    padding: 0 14px 12px;
    list-style: none;
  }

  .tr-presentes > li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 0;
    border-top: 1px solid var(--ds-line);
  }

  /* Cabeçalho da lista: mesma caixa dos números embaixo (34px de largura, 8px
     de folga dos lados) pra cada rótulo cair em cima da sua coluna. */
  .tr-cab {
    justify-content: space-between;
    padding: 7px 0 4px;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ds-text-5);
  }

  .tr-cab-col {
    min-width: 34px;
    padding: 0 8px;
    text-align: center;
  }

  .tr-avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--ds-line-strong);
    background: var(--ds-bg-alt);
    overflow: hidden;
    font-family: var(--ds-font-display);
    font-size: 0.8rem;
    color: var(--ds-text-3);
  }

  .tr-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tr-nome {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    font-size: 0.88rem;
    line-height: 1.25;
  }

  .tr-nome small {
    font-size: 0.72rem;
    color: var(--ds-text-4);
  }

  .tr-niveis {
    flex: none;
    display: flex;
    gap: 6px;
  }

  .tr-nivel {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    min-width: 34px;
    justify-content: center;
    padding: 3px 8px;
    border: 1px solid var(--ds-line-strong);
    border-radius: 999px;
    font-size: 0.76rem;
    color: var(--ds-text-2);
  }

  .tr-nivel--classe {
    color: var(--ds-text-4);
  }

  .tr-nivel.subiu {
    border-color: var(--ds-gold-dim);
    background: var(--ds-gold-wash);
    color: var(--ds-gold-light);
  }

  .tr-seta {
    font-size: 0.6rem;
  }
</style>
