---
import Icon from "./Icon.astro";

interface Registro {
  id_treino: number;
  data_treino: string;
  nome: string;
  foto_url: string | null;
  nome_classe: string;
  nivel_geral: number;
  subiu_nivel_geral: boolean;
  subida_nivel_geral: number;
  nivel_classe: number;
  subiu_nivel_classe: boolean;
}

interface Props {
  idTreino: number;
  dataTreino: string;
  attendees: Registro[];
}

const { idTreino, dataTreino, attendees } = Astro.props;
const dataFormatada = new Date(dataTreino).toLocaleDateString("pt-BR");
---

<details class="modalidades-box card registro-treino-card">
  <summary>
    <div class="modalidades-summary-text">
      <h2 class="modalidades-button">Treino Nº {idTreino}</h2>
      <div class="modalidade-tags">
        <span class="stat-pill">{dataFormatada}</span>
        <span class="stat-pill">{attendees.length} participante{attendees.length === 1 ? "" : "s"}</span>
      </div>
    </div>
    <Icon name="chevron-forward" class="modalidades-chevron" />
  </summary>
  <div class="modalidades-conteudo">
    <div class="table-scroll">
      <table class="ranking-tabela ranking-tabela--treino">
        <thead>
          <tr>
            <th class="col-nome">Nome</th>
            <th class="col-faixa">Classe</th>
            <th class="col-stat">Nível Geral</th>
            <th class="col-stat">Nível Classe</th>
          </tr>
        </thead>
        <tbody>
          {attendees.map((r) => (
            <tr>
              <td class="col-nome">
                <span class="row-avatar">
                  {r.foto_url ? <img src={r.foto_url} alt="" /> : r.nome.charAt(0).toUpperCase()}
                </span>
                <span class="row-name">{r.nome}</span>
              </td>
              <td class="col-faixa">{r.nome_classe}</td>
              <td class="col-stat">
                <span class={`stat-pill ${r.subiu_nivel_geral ? "stat-pill-up" : ""}`}>
                  {r.nivel_geral}
                  {r.subiu_nivel_geral && <span class="level-up-arrow">{"▲".repeat(r.subida_nivel_geral)}</span>}
                </span>
              </td>
              <td class="col-stat">
                <span class={`stat-pill ${r.subiu_nivel_classe ? "stat-pill-up" : ""}`}>
                  {r.nivel_classe}
                  {r.subiu_nivel_classe && <span class="level-up-arrow">▲</span>}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</details>
