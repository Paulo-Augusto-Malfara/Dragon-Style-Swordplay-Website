---
// Card do próximo treino agendado.
//
// Virou componente quando ganhou o segundo dono: a landing e a página Como
// Participar mostram o mesmo card, e a consulta, o fuso e a formatação de data
// precisam ser os mesmos nos dois lugares -- duplicar isso é como o site passa
// a dizer duas datas diferentes pro mesmo treino.
import Icon from "./Icon.astro";
import ConfirmarPresenca from "./agenda/ConfirmarPresenca.svelte";
import { supabasePublic } from "../lib/supabase-public";

const capitalizar = (s: string) => s.charAt(0).toUpperCase() + s.slice(1).replace(".", "");

// o servidor (Vercel) roda em UTC: calcular "hoje" já no fuso do Brasil evita
// esconder o treino de hoje mais cedo do que deveria.
const hojeBrasil = new Date().toLocaleDateString("en-CA", { timeZone: "America/Sao_Paulo" });

/* Antes o card pulava qualquer data já amarrada a um treino, e com isso o
 * treino que está acontecendo sumia da home no dia dele, dando lugar ao de
 * daqui a uma semana. Quem chega na home no domingo quer ver justamente o de
 * hoje. Então o aberto fica, marcado como em andamento; quem sai da frente é
 * só o já fechado, que não é o próximo de ninguém. Três candidatos bastam pra
 * pular os fechados do dia sem uma segunda ida ao banco. */
const { data: agendaData } = await supabasePublic
  .from("fAgendaTreinos")
  .select("id_agenda, data_treino, horario_inicio, horario_termino, local, link_maps, id_treino")
  .gte("data_treino", hojeBrasil)
  .eq("status", "agendado")
  .order("data_treino")
  .order("horario_inicio")
  .limit(3);

const candidatos = agendaData ?? [];
const idsTreino = candidatos.map((a) => a.id_treino).filter((id): id is number => id != null);
// A v_treinos_publicos só lista treino finalizado, e é a única leitura de
// treino que o visitante alcança: a fTreinos é fechada pra quem não é staff.
const { data: fechados } = idsTreino.length
  ? await supabasePublic.from("v_treinos_publicos").select("id_treino").in("id_treino", idsTreino)
  : { data: [] };
const treinoFechado = new Set((fechados ?? []).map((t) => t.id_treino));
const escolhida = candidatos.find((a) => a.id_treino == null || !treinoFechado.has(a.id_treino)) ?? null;

const proximoTreino = escolhida
  ? (() => {
      const d = new Date(escolhida.data_treino + "T00:00:00");
      return {
        diaSemana: capitalizar(d.toLocaleDateString("pt-BR", { weekday: "short" })),
        dia: String(d.getDate()).padStart(2, "0"),
        mes: capitalizar(d.toLocaleDateString("pt-BR", { month: "short" })),
        horario: escolhida.horario_termino
          ? `${escolhida.horario_inicio.slice(0, 5)} – ${escolhida.horario_termino.slice(0, 5)}`
          : escolhida.horario_inicio.slice(0, 5),
        local: escolhida.local,
        linkMaps: escolhida.link_maps as string | null,
        idAgenda: escolhida.id_agenda as number,
        emAndamento: escolhida.id_treino != null,
      };
    })()
  : null;

const { count: contagemConfirmados } = proximoTreino && !proximoTreino.emAndamento
  ? await supabasePublic
      .from("fAgendaConfirmacoes")
      .select("id_confirmacao", { count: "exact", head: true })
      .eq("id_agenda", proximoTreino.idAgenda)
  : { count: 0 };
---

{
  proximoTreino ? (
    <div class="treino-card">
      <div class="treino-date">
        <div class="dow">{proximoTreino.diaSemana}</div>
        <div class="num">{proximoTreino.dia}</div>
        <div class="mon">{proximoTreino.mes}</div>
      </div>
      <div class="treino-info">
        <h3>
          Treino Aberto
          {proximoTreino.emAndamento && <span class="status-badge status-badge--andamento">Em andamento</span>}
        </h3>
        <div class="treino-meta">
          <span>
            <Icon name="clock" />
            {proximoTreino.horario}
          </span>
          <span>
            <Icon name="location" />
            {proximoTreino.linkMaps ? (
              <a href={proximoTreino.linkMaps} target="_blank" rel="noopener noreferrer" class="links-de-texto">
                {proximoTreino.local}
              </a>
            ) : (
              proximoTreino.local
            )}
          </span>
        </div>
      </div>
      {proximoTreino.emAndamento ? (
        <p class="treino-encerrado">As confirmações deste treino foram encerradas.</p>
      ) : (
        <ConfirmarPresenca idAgenda={proximoTreino.idAgenda} contagemInicial={contagemConfirmados ?? 0} client:load />
      )}
    </div>
  ) : (
    <p class="vazio">Nenhum treino agendado no momento.</p>
  )
}
