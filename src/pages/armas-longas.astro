---
import { getEntry, render } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import EquipGlossario from "../components/EquipGlossario.astro";
import ArmaCard from "../components/ArmaCard.astro";

const entry = await getEntry("equipamentos", "armas-longas");
const { Content } = await render(entry);
---

<PageLayout title={entry.data.title} prev={entry.data.prev} next={entry.data.next}>
  <section>
    <Content />
    {entry.data.showGlossario && <EquipGlossario />}
  </section>
  <section>
    <div class="lista-de-equipamentos">
      <br />
      {entry.data.armas.map((arma) => <ArmaCard {...arma} />)}
    </div>
  </section>
</PageLayout>
