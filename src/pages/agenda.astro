---
import PageLayout from "../layouts/PageLayout.astro";
import { supabasePublic } from "../lib/supabase-public";

export const prerender = false;

// ponytail: o servidor (Vercel) roda em UTC -- usar toISOString() aqui
// pode cortar o treino de hoje um pouco mais cedo do que o esperado no
// horário de Brasília. Calcula "hoje" já no fuso do Brasil.
const hojeBrasil = new Date().toLocaleDateString("en-CA", { timeZone: "America/Sao_Paulo" });

const { data } = await supabasePublic
  .from("fAgendaTreinos")
  .select("id_agenda, data_treino, horario_inicio, horario_termino, cidade, local, endereco, link_maps, status")
  .gte("data_treino", hojeBrasil)
  .order("data_treino")
  .order("horario_inicio");

const proximosTreinos = data ?? [];

// HH:MM:SS -> HH:MM (o campo time do Postgres sempre traz os segundos).
const formatHora = (h: string) => h.slice(0, 5);

const capitalizar = (s: string) => s.charAt(0).toUpperCase() + s.slice(1).replace(".", "");
---

<PageLayout title="Agenda de Treinos" prev={{ href: "/registro-de-treinos", label: "Registro de Treinos" }}>
  <section>
    <p>Confira abaixo os próximos treinos agendados do Dragon Style.</p>
    <br />
  </section>
  {
    proximosTreinos.length === 0 ? (
      <p class="dashboard-empty">Nenhum treino agendado no momento.</p>
    ) : (
      <div class="agenda-lista">
        {proximosTreinos.map((t) => (
          <article class="agenda-card">
            <div class="agenda-card-topo">
              <div class="agenda-card-data">
                <span class="agenda-card-semana">
                  {capitalizar(new Date(t.data_treino + "T00:00:00").toLocaleDateString("pt-BR", { weekday: "short" }))}
                </span>
                <span class="agenda-card-dia">{new Date(t.data_treino + "T00:00:00").getDate()}</span>
                <span class="agenda-card-mes">
                  {capitalizar(new Date(t.data_treino + "T00:00:00").toLocaleDateString("pt-BR", { month: "short" }))}
                </span>
              </div>
              <div class="agenda-card-corpo">
                <p class="agenda-card-linha">
                  <span class={`status-badge status-badge--${t.status}`}>
                    {t.status === "agendado" ? "Agendado" : "Cancelado"}
                  </span>
                </p>
                <p class="agenda-card-linha">
                  <span class="gold-title">Horário:</span> {formatHora(t.horario_inicio)}
                  {t.horario_termino ? ` às ${formatHora(t.horario_termino)}` : ""}
                </p>
                <p class="agenda-card-linha">
                  <span class="gold-title">Local:</span> {t.local}
                </p>
                {t.endereco && (
                  <p class="agenda-card-linha">
                    <span class="gold-title">Endereço:</span> {t.endereco}
                  </p>
                )}
              </div>
            </div>
            {t.link_maps && (
              <a href={t.link_maps} target="_blank" rel="noopener noreferrer" class="btn btn-sm agenda-card-mapa">
                Ver no mapa
              </a>
            )}
          </article>
        ))}
      </div>
    )
  }
</PageLayout>
