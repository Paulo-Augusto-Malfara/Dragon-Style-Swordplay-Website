---
import AdminShell from "../../../components/admin/AdminShell.astro";
import PostEditor from "../../../components/admin/PostEditor.svelte";

export const prerender = false;

const { id } = Astro.params;
---

<AdminShell
  title={id === "new" ? "Nova novidade" : "Editar novidade"}
  voltar={{ href: "/admin/posts", label: "Novidades" }}
>
  <PostEditor id={id} client:load />
</AdminShell>
