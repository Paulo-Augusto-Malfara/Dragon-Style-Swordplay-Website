---
import AdminShell from "../../../components/admin/AdminShell.astro";
import AdminList from "../../../components/admin/AdminList.svelte";

export const prerender = false;

const { membro } = Astro.locals;
if (!membro.isOrganizador) return Astro.redirect("/admin");
---

<AdminShell
  title="Novidades"
  resumo="O que for publicado aqui aparece na home pra qualquer visitante, sem login."
>
  <AdminList kind="posts" client:load />
</AdminShell>
