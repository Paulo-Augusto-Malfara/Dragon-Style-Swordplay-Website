---
import AdminShell from "../../../components/admin/AdminShell.astro";
import EventoAtivo from "../../../components/admin/EventoAtivo.svelte";

export const prerender = false;

const { membro } = Astro.locals;
const { id } = Astro.params;
---

<AdminShell title={`Evento #${id}`} voltar={{ href: "/admin/eventos", label: "Eventos" }}>
  <EventoAtivo
    idEvento={Number(id)}
    souOrganizador={membro.isOrganizador}
    souAdminSistema={membro.isAdminSistema}
    client:load
  />
</AdminShell>
