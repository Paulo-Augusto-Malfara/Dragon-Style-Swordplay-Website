---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AbrirEvento from "../../../components/admin/AbrirEvento.svelte";
import EventoCard from "../../../components/EventoCard.astro";
import { createSupabaseServerClient } from "../../../lib/supabase-server";

export const prerender = false;

const { membro } = Astro.locals;
const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);

const { data: aberto } = await supabase
  .from("fEventos")
  .select("id_evento, nome_evento, cidade, status")
  .eq("status", "aberto")
  .maybeSingle();

const { data: historico } = await supabase
  .from("fEventos")
  .select("id_evento, nome_evento, cidade, data_evento, numero_dia")
  .eq("status", "fechado")
  .order("data_evento", { ascending: false })
  .limit(20);

// participantes de cada evento do histórico (com nível geral e se subiu),
// pra mostrar dentro do card ao expandir
const idsEventos = (historico ?? []).map((e) => e.id_evento);
const participantesPorEvento = new Map<
  number,
  { nome: string; foto_url: string | null; ph_ganho: number; nivel_geral: number; subiu_nivel_geral: boolean }[]
>();
if (idsEventos.length > 0) {
  const { data: registros } = await supabase
    .from("v_registro_eventos")
    .select("id_evento, nome, foto_url, ph_ganho, nivel_geral, subiu_nivel_geral")
    .in("id_evento", idsEventos);

  for (const r of registros ?? []) {
    const lista = participantesPorEvento.get(r.id_evento) ?? [];
    lista.push({
      nome: r.nome,
      foto_url: r.foto_url,
      ph_ganho: r.ph_ganho,
      nivel_geral: r.nivel_geral,
      subiu_nivel_geral: r.subiu_nivel_geral,
    });
    participantesPorEvento.set(r.id_evento, lista);
  }
}
---

<BaseLayout title="Admin - Eventos">
  <h1>Eventos</h1>

  {
    aberto ? (
      <div class="admin-form">
        <p class="gold-title">
          Evento em andamento: {aberto.nome_evento} ({aberto.cidade})
        </p>
        <a href={`/admin/eventos/${aberto.id_evento}`} class="btn btn-primary">
          Ir para o evento
        </a>
      </div>
    ) : membro.isOrganizador ? (
      <AbrirEvento eventosRecentes={historico ?? []} client:load />
    ) : (
      <p class="dashboard-empty">Nenhum evento aberto no momento. Aguarde um organizador abrir um evento.</p>
    )
  }

  <h2>Histórico</h2>
  {historico && historico.length > 0 ? (
    <div class="modalidades modalidades-grid treinos-grid">
      {historico.map((e) => (
        <EventoCard
          nomeEvento={e.nome_evento}
          cidade={e.cidade}
          dataEvento={e.data_evento}
          numeroDia={e.numero_dia}
          participantes={participantesPorEvento.get(e.id_evento) ?? []}
        />
      ))}
    </div>
  ) : (
    <p class="dashboard-empty">Nenhum evento finalizado ainda.</p>
  )}
</BaseLayout>
