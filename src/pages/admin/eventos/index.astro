---
import AdminShell from "../../../components/admin/AdminShell.astro";
import AbrirEvento from "../../../components/admin/AbrirEvento.svelte";
import EventoCard from "../../../components/EventoCard.astro";
import { createSupabaseServerClient } from "../../../lib/supabase-server";

export const prerender = false;

const { membro } = Astro.locals;
const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);

const { data: aberto } = await supabase
  .from("fEventos")
  .select("id_evento, nome_evento, cidade, status")
  .eq("status", "aberto")
  .maybeSingle();

const { data: historico } = await supabase
  .from("fEventos")
  .select("id_evento, nome_evento, cidade, data_evento, numero_dia")
  .eq("status", "fechado")
  .order("data_evento", { ascending: false })
  .limit(20);

// participantes de cada evento do histórico (com nível geral e se subiu),
// pra mostrar dentro do card ao expandir
const idsEventos = (historico ?? []).map((e) => e.id_evento);
const participantesPorEvento = new Map<
  number,
  { nome: string; foto_url: string | null; ph_ganho: number; nivel_geral: number; subiu_nivel_geral: boolean; subida_nivel_geral: number }[]
>();
if (idsEventos.length > 0) {
  const { data: registros } = await supabase
    .from("v_registro_eventos")
    .select("id_evento, nome, foto_url, ph_ganho, nivel_geral, subiu_nivel_geral, subida_nivel_geral")
    .in("id_evento", idsEventos);

  for (const r of registros ?? []) {
    const lista = participantesPorEvento.get(r.id_evento) ?? [];
    lista.push({
      nome: r.nome,
      foto_url: r.foto_url,
      ph_ganho: r.ph_ganho,
      nivel_geral: r.nivel_geral,
      subiu_nivel_geral: r.subiu_nivel_geral,
      subida_nivel_geral: r.subida_nivel_geral,
    });
    participantesPorEvento.set(r.id_evento, lista);
  }
}
---

<AdminShell title="Eventos" resumo="Só pode existir um evento aberto por vez.">
  {
    aberto ? (
      <a class="evento-aberto" href={`/admin/eventos/${aberto.id_evento}`}>
        <span class="ea-tipo">Evento em andamento</span>
        <span class="ea-titulo">
          {aberto.nome_evento}, {aberto.cidade}
        </span>
        <span class="ea-acao">Registrar participantes e fechar</span>
      </a>
    ) : membro.isOrganizador ? (
      <AbrirEvento eventosRecentes={historico ?? []} client:load />
    ) : (
      <p class="vazio">Nenhum evento aberto no momento. Aguarde um organizador abrir um evento.</p>
    )
  }

  <div class="admin-secao-cab">
    <h2>Eventos fechados <span class="contagem">{historico?.length ?? 0}</span></h2>
  </div>

  {historico && historico.length > 0 ? (
    <div class="modalidades modalidades-grid treinos-grid">
      {historico.map((e) => (
        <EventoCard
          nomeEvento={e.nome_evento}
          cidade={e.cidade}
          dataEvento={e.data_evento}
          numeroDia={e.numero_dia}
          participantes={participantesPorEvento.get(e.id_evento) ?? []}
        />
      ))}
    </div>
  ) : (
    <p class="vazio">Nenhum evento finalizado ainda.</p>
  )}
</AdminShell>

<style>
  /* Mesmo cartão de "precisa de atenção" do hub e da tela de treinos. */
  .evento-aberto {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-bottom: 8px;
    padding: 14px 16px;
    border: 1px solid var(--ds-gold-dim);
    border-radius: 10px;
    background: var(--ds-gold-wash);
    text-decoration: none;
  }

  .ea-tipo {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ds-gold);
  }

  .ea-titulo {
    font-family: var(--ds-font-display);
    font-size: 1.02rem;
    color: var(--ds-gold-light);
  }

  .ea-acao {
    font-size: 0.86rem;
    color: var(--ds-text-3);
  }
</style>
