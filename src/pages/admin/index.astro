---
import AdminShell from "../../components/admin/AdminShell.astro";
import { createSupabaseServerClient } from "../../lib/supabase-server";

export const prerender = false;

const { membro } = Astro.locals;
const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);

// Data de hoje no fuso do Brasil, não em UTC: o servidor da Vercel roda em
// UTC, e das 21h em diante lá já é o dia seguinte -- o "próximo treino"
// pularia o treino de hoje à noite. en-CA é o atalho pra sair YYYY-MM-DD.
const hojeBR = new Date().toLocaleDateString("en-CA", { timeZone: "America/Sao_Paulo" });
const inicioDoAno = hojeBR.slice(0, 4) + "-01-01";

// O hub era uma lista de cinco links. O que faltava era justamente o que se
// abre o painel pra saber: tem alguma coisa em aberto agora? Treino esquecido
// aberto trava o registro de presença de todo mundo até alguém fechar.
//
// E, junto disso, os quatro números que respondem "como está o grupo" sem
// precisar entrar em seção nenhuma. Todas as consultas são contagem (head:
// true não traz linha, só o total) ou uma linha só.
const [treino, evento, ativos, treinosDoAno, proximo] = await Promise.all([
  supabase
    .from("fTreinos")
    .select("id_treino, data_treino, status")
    .in("status", ["aberto", "aguardando_data"])
    .maybeSingle(),
  supabase
    .from("fEventos")
    .select("id_evento, nome_evento, cidade")
    .eq("status", "aberto")
    .maybeSingle(),
  supabase
    .from("dMembros")
    .select("id_membro", { count: "exact", head: true })
    .eq("status_ativo", true)
    .eq("oculto", false),
  supabase
    .from("fTreinos")
    .select("id_treino", { count: "exact", head: true })
    .eq("status", "finalizado")
    .gte("data_treino", inicioDoAno),
  supabase
    .from("fAgendaTreinos")
    .select("data_treino, cidade")
    .eq("status", "agendado")
    .gte("data_treino", hojeBR)
    .order("data_treino")
    .limit(1)
    .maybeSingle(),
]);

const dataBR = (d: string) =>
  new Date(d + "T00:00:00").toLocaleDateString("pt-BR", { day: "2-digit", month: "2-digit" });

const numeros = [
  { valor: ativos.count ?? 0, rotulo: "Membros ativos" },
  { valor: treinosDoAno.count ?? 0, rotulo: `Treinos em ${hojeBR.slice(0, 4)}` },
  {
    valor: proximo.data ? dataBR(proximo.data.data_treino) : "—",
    rotulo: proximo.data ? `Próximo, ${proximo.data.cidade}` : "Nada na agenda",
  },
];

const emAberto = [
  treino.data && {
    href: `/admin/treinos/${treino.data.id_treino}`,
    tipo: "Treino em andamento",
    titulo:
      treino.data.status === "aguardando_data"
        ? `Treino #${treino.data.id_treino}, aguardando data`
        : `Treino de ${new Date(treino.data.data_treino + "T00:00:00").toLocaleDateString("pt-BR")}`,
    acao: "Registrar presenças e fechar",
  },
  evento.data && {
    href: `/admin/eventos/${evento.data.id_evento}`,
    tipo: "Evento em andamento",
    titulo: `${evento.data.nome_evento}, ${evento.data.cidade}`,
    acao: "Registrar participantes e fechar",
  },
].filter(Boolean) as { href: string; tipo: string; titulo: string; acao: string }[];

const atalhos = [
  { href: "/admin/membros", label: "Membros", desc: "Cadastrar, editar e vincular login." },
  { href: "/admin/treinos", label: "Treinos", desc: "Abrir treino, registrar presença, ver histórico." },
  { href: "/admin/eventos", label: "Eventos", desc: "Abrir evento e lançar participação." },
  ...(membro.isOrganizador
    ? [{ href: "/admin/agenda", label: "Agenda", desc: "Marcar os próximos treinos." }]
    : []),
  ...(membro.isAdminSistema
    ? [{ href: "/admin/doacoes", label: "Doações", desc: "Lançar e conferir as doações." }]
    : []),
  // Novidades e Modalidades eram duas listas soltas no fim do hub. Como
  // seção, entram na mesma grade e a tela inicial volta a ser só uma escolha
  // de para onde ir.
  ...(membro.isOrganizador
    ? [
        { href: "/admin/posts", label: "Novidades", desc: "Escrever e publicar avisos na home." },
        { href: "/admin/modalidades", label: "Modalidades", desc: "Regras e mínimo de participantes." },
      ]
    : []),
];
---

<AdminShell title="Painel Administrativo" resumo={`Logado como ${membro.nome}.`}>
  <ul class="admin-stats">
    {
      numeros.map((n) => (
        <li class="admin-stat">
          <span class="admin-stat-valor">{n.valor}</span>
          <span class="admin-stat-rotulo">{n.rotulo}</span>
        </li>
      ))
    }
  </ul>

  {
    emAberto.length > 0 && (
      <section class="hub-aberto">
        <h2>Precisa de atenção</h2>
        <ul>
          {emAberto.map((i) => (
            <li>
              <a href={i.href}>
                <span class="hub-tipo">{i.tipo}</span>
                <span class="hub-titulo">{i.titulo}</span>
                <span class="hub-acao">{i.acao}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <h2>Seções</h2>
  <ul class="hub-atalhos">
    {
      atalhos.map((a) => (
        <li>
          <a href={a.href}>
            <span class="hub-label">{a.label}</span>
            <span class="hub-desc">{a.desc}</span>
          </a>
        </li>
      ))
    }
  </ul>

</AdminShell>

<style>
  .hub-aberto ul,
  .hub-atalhos {
    list-style: none;
    margin: 0 0 8px;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .hub-atalhos {
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
  }

  .hub-aberto a,
  .hub-atalhos a {
    display: flex;
    flex-direction: column;
    gap: 3px;
    height: 100%;
    padding: 14px 16px;
    border: 1px solid var(--ds-line);
    border-radius: 12px;
    background: var(--ds-surface);
    text-decoration: none;
    transition:
      border-color 0.15s,
      background 0.15s;
  }

  .hub-aberto a:hover,
  .hub-aberto a:focus-visible,
  .hub-atalhos a:hover,
  .hub-atalhos a:focus-visible {
    border-color: var(--ds-gold-dim);
    background: var(--ds-gold-wash);
  }

  /* O que está em aberto tem que puxar o olho antes das seções. */
  .hub-aberto a {
    border-color: var(--ds-gold-dim);
    background: var(--ds-gold-wash);
  }

  .hub-tipo {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ds-gold);
  }

  .hub-titulo,
  .hub-label {
    font-family: var(--ds-font-display);
    font-size: 1.02rem;
    color: var(--ds-gold-light);
  }

  .hub-acao,
  .hub-desc {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--ds-text-3);
  }

</style>
