---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminList from "../../components/admin/AdminList.svelte";

export const prerender = false;

const { membro } = Astro.locals;
---

<BaseLayout title="Admin">
  <h1>Painel Administrativo</h1>
  <p>Logado como {membro.nome}</p>

  <div class="admin-list-actions">
    <a href="/admin/membros" class="btn">Membros</a>
    <a href="/admin/treinos" class="btn">Treinos</a>
    <a href="/admin/eventos" class="btn">Eventos</a>
    {membro.isOrganizador && <a href="/admin/agenda" class="btn">Agenda</a>}
    {membro.isAdminSistema && <a href="/admin/doacoes" class="btn">Doações</a>}
  </div>

  {
    membro.isOrganizador && (
      <>
        <h2>Novidades</h2>
        <AdminList kind="posts" client:load />

        <h2>Modalidades</h2>
        <AdminList kind="modalidades" client:load />
      </>
    )
  }
</BaseLayout>
