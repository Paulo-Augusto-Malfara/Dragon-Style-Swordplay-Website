---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminList from "../../components/admin/AdminList.svelte";

export const prerender = false;

const { membro } = Astro.locals;
---

<BaseLayout title="Admin">
  <h1>Painel Administrativo</h1>

  <div class="admin-hub">
    <p class="admin-hub-greeting">Logado como <strong>{membro.nome}</strong></p>
    <nav class="admin-nav">
      <a href="/admin/membros" class="admin-nav-item">Membros</a>
      <a href="/admin/treinos" class="admin-nav-item">Treinos</a>
      <a href="/admin/eventos" class="admin-nav-item">Eventos</a>
      {membro.isOrganizador && <a href="/admin/agenda" class="admin-nav-item">Agenda</a>}
      {membro.isAdminSistema && <a href="/admin/doacoes" class="admin-nav-item">Doações</a>}
    </nav>
  </div>

  {
    membro.isOrganizador && (
      <>
        <h2>Novidades</h2>
        <AdminList kind="posts" client:load />

        <h2>Modalidades</h2>
        <AdminList kind="modalidades" client:load />
      </>
    )
  }
</BaseLayout>
