---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DoacoesPainel from "../../../components/admin/DoacoesPainel.svelte";

export const prerender = false;

const { membro } = Astro.locals;
if (!membro.isAdminSistema) return Astro.redirect("/admin");
---

<BaseLayout title="Admin - Doações">
  <h1>Doações</h1>
  <DoacoesPainel client:load />
</BaseLayout>
