---
import AdminShell from "../../../components/admin/AdminShell.astro";
import DoacoesPainel from "../../../components/admin/DoacoesPainel.svelte";

export const prerender = false;

const { membro } = Astro.locals;
if (!membro.isOrganizador) return Astro.redirect("/admin");
---

<AdminShell
  title="Doações"
  resumo={membro.isAdminSistema
    ? "Lançamento e conferência das doações do grupo."
    : "Conferência das doações. Só admin do sistema pode lançar."}
>
  <DoacoesPainel client:load podeEditar={membro.isAdminSistema} />
</AdminShell>
