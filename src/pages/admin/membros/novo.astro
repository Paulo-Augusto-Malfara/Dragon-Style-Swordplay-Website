---
import AdminShell from "../../../components/admin/AdminShell.astro";
import RecrutarMembro from "../../../components/admin/RecrutarMembro.svelte";

export const prerender = false;

const { membro } = Astro.locals;
---

<AdminShell title="Cadastrar membro" voltar={{ href: "/admin/membros", label: "Membros" }}>
  <RecrutarMembro meuIdMembro={membro.id_membro} client:load />
</AdminShell>
