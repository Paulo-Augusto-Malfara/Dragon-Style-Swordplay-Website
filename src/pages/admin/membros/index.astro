---
import AdminShell from "../../../components/admin/AdminShell.astro";
import MembrosList from "../../../components/admin/MembrosList.svelte";

export const prerender = false;

const { membro } = Astro.locals;
---

<AdminShell
  title="Membros"
  resumo={membro.isAdminSistema
    ? "Cadastro do grupo. Toque num membro para editar."
    : "Cadastro do grupo. Você cadastra membro novo; editar é do admin do sistema."}
>
  <MembrosList podeEditar={membro.isAdminSistema} client:load />
</AdminShell>
