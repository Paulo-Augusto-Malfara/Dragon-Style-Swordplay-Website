---
import AdminShell from "../../../components/admin/AdminShell.astro";
import MembroEditor from "../../../components/admin/MembroEditor.svelte";

export const prerender = false;

const { membro } = Astro.locals;
if (!membro.isAdminSistema) return Astro.redirect("/admin/membros");

const { id } = Astro.params;
---

<AdminShell title="Editar membro" voltar={{ href: "/admin/membros", label: "Membros" }}>
  <MembroEditor id={id} client:load />
</AdminShell>
