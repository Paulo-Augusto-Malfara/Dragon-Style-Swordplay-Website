---
import AdminShell from "../../../components/admin/AdminShell.astro";
import AbrirTreino from "../../../components/admin/AbrirTreino.svelte";
import { createSupabaseServerClient } from "../../../lib/supabase-server";

export const prerender = false;

const { membro } = Astro.locals;
const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);

const { data: aberto } = await supabase
  .from("fTreinos")
  .select("id_treino, data_treino, status")
  .in("status", ["aberto", "aguardando_data"])
  .maybeSingle();

const { data: historico } = await supabase
  .from("fTreinos")
  .select("id_treino, data_treino, status, fPresencas(count)")
  .eq("status", "finalizado")
  .order("data_treino", { ascending: false })
  .limit(20);

const dataBR = (d: string) => new Date(d + "T00:00:00").toLocaleDateString("pt-BR");
---

<AdminShell title="Treinos" resumo="Só pode existir um treino aberto por vez.">
  {
    aberto ? (
      <a class="treino-aberto" href={`/admin/treinos/${aberto.id_treino}`}>
        <span class="ta-tipo">Treino em andamento</span>
        <span class="ta-titulo">
          {aberto.status === "aguardando_data"
            ? `Treino #${aberto.id_treino}, aguardando data`
            : `Treino de ${dataBR(aberto.data_treino)}`}
        </span>
        <span class="ta-acao">Registrar presenças e fechar</span>
      </a>
    ) : membro.isOrganizador ? (
      <AbrirTreino client:load />
    ) : (
      <p class="dashboard-empty">
        Nenhum treino aberto no momento. Aguarde um organizador abrir um treino.
      </p>
    )
  }

  <h2>Histórico</h2>
  {
    historico && historico.length > 0 ? (
      <ul class="admin-list">
        {historico.map((t) => {
          const qtd = t.fPresencas?.[0]?.count ?? 0;
          return (
            <li class="historico-item">
              <a href={`/admin/treinos/${t.id_treino}`} class="historico-link">
                <span class="rank-badge">{t.id_treino}</span>
                <span>
                  {dataBR(t.data_treino)}, {qtd} combatente{qtd === 1 ? "" : "s"}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="dashboard-empty">Nenhum treino finalizado ainda.</p>
    )
  }
</AdminShell>

<style>
  /* Mesmo cartão do "precisa de atenção" do hub: um treino aberto é a única
     coisa da tela que alguém precisa resolver hoje. */
  .treino-aberto {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-bottom: 8px;
    padding: 14px 16px;
    border: 1px solid var(--ds-gold-dim);
    border-radius: 10px;
    background: var(--ds-gold-wash);
    text-decoration: none;
  }

  .ta-tipo {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ds-gold);
  }

  .ta-titulo {
    font-family: var(--ds-font-display);
    font-size: 1.02rem;
    color: var(--ds-gold-light);
  }

  .ta-acao {
    font-size: 0.86rem;
    color: var(--ds-text-3);
  }
</style>
