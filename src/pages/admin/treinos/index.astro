---
import AdminShell from "../../../components/admin/AdminShell.astro";
import AbrirTreino from "../../../components/admin/AbrirTreino.svelte";
import Paginacao from "../../../components/Paginacao.astro";
import { createSupabaseServerClient } from "../../../lib/supabase-server";

export const prerender = false;

const { membro } = Astro.locals;
const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);

const { data: aberto } = await supabase
  .from("fTreinos")
  .select("id_treino, data_treino, status")
  .in("status", ["aberto", "aguardando_data"])
  .maybeSingle();

const POR_PAGINA = 10;
const pedida = Math.max(1, Number(Astro.url.searchParams.get("pagina")) || 1);

const { data: historico, count: totalFechados } = await supabase
  .from("fTreinos")
  .select("id_treino, data_treino, status, fPresencas(count)", { count: "exact" })
  .eq("status", "finalizado")
  .order("data_treino", { ascending: false })
  // Desempate estável: sem ele, dois treinos na mesma data podem trocar de
  // ordem entre uma página e outra, e aí um some e o outro aparece duas vezes.
  .order("id_treino", { ascending: false })
  .range((pedida - 1) * POR_PAGINA, pedida * POR_PAGINA - 1);

const totalPaginas = Math.max(1, Math.ceil((totalFechados ?? 0) / POR_PAGINA));
const pagina = Math.min(pedida, totalPaginas);

// Página fora do intervalo (?pagina=9 de 2): volta pra primeira em vez de
// mostrar uma lista vazia sem link nenhum de saída.
if (pedida > totalPaginas) return Astro.redirect("/admin/treinos");

const dataBR = (d: string) => new Date(d + "T00:00:00").toLocaleDateString("pt-BR");
const diaSemana = (d: string) =>
  new Date(d + "T00:00:00").toLocaleDateString("pt-BR", { weekday: "long" });
---

<AdminShell title="Treinos" resumo="Só pode existir um treino aberto por vez.">
  {
    aberto ? (
      <a class="treino-aberto" href={`/admin/treinos/${aberto.id_treino}`}>
        <span class="ta-tipo">Treino em andamento</span>
        <span class="ta-titulo">
          {aberto.status === "aguardando_data"
            ? `Treino #${aberto.id_treino}, aguardando data`
            : `Treino de ${dataBR(aberto.data_treino)}`}
        </span>
        <span class="ta-acao">Registrar presenças e fechar</span>
      </a>
    ) : membro.isOrganizador ? (
      <AbrirTreino client:load />
    ) : (
      <p class="vazio">
        Nenhum treino aberto no momento. Aguarde um organizador abrir um treino.
      </p>
    )
  }

  <div class="admin-secao-cab">
    <h2>Treinos fechados <span class="contagem">{totalFechados ?? 0}</span></h2>
  </div>

  {
    historico && historico.length > 0 ? (
      <ul class="admin-list">
        {historico.map((t) => {
          const qtd = t.fPresencas?.[0]?.count ?? 0;
          return (
            <li>
              <a href={`/admin/treinos/${t.id_treino}`} class="row-link">
                <span class="rank-badge">{t.id_treino}</span>
                <span class="row-corpo">
                  <span class="row-titulo">{dataBR(t.data_treino)}</span>
                  <span class="row-meta">
                    <span>{diaSemana(t.data_treino)}</span>
                    <span>
                      {qtd} combatente{qtd === 1 ? "" : "s"}
                    </span>
                  </span>
                </span>
                <span class="row-acoes ver-treino">Ver</span>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="vazio">Nenhum treino finalizado ainda.</p>
    )
  }

  <Paginacao
    pagina={pagina}
    totalPaginas={totalPaginas}
    base="/admin/treinos"
    rotulo="Páginas dos treinos fechados"
  />
</AdminShell>

<style>
  /* Mesmo cartão do "precisa de atenção" do hub: um treino aberto é a única
     coisa da tela que alguém precisa resolver hoje. */
  .treino-aberto {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-bottom: 8px;
    padding: 14px 16px;
    border: 1px solid var(--ds-gold-dim);
    border-radius: 12px;
    background: var(--ds-gold-wash);
    text-decoration: none;
  }

  .ta-tipo {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ds-gold);
  }

  .ta-titulo {
    font-family: var(--ds-font-display);
    font-size: 1.02rem;
    color: var(--ds-gold-light);
  }

  .ta-acao {
    font-size: 0.86rem;
    color: var(--ds-text-3);
  }

  .ver-treino {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ds-text-5);
  }

  .admin-list li:hover .ver-treino {
    color: var(--ds-gold-light);
  }
</style>
