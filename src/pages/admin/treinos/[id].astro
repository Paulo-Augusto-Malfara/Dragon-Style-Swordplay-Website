---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TreinoAtivo from "../../../components/admin/TreinoAtivo.svelte";

export const prerender = false;

const { membro } = Astro.locals;
const { id } = Astro.params;
---

<BaseLayout title="Admin - Treino">
  <h1>Treino #{id}</h1>
  <TreinoAtivo
    idTreino={Number(id)}
    souAdminSistema={membro.isAdminSistema}
    meuIdMembro={membro.id_membro}
    client:load
  />
</BaseLayout>
