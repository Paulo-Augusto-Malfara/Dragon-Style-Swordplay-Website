---
import AdminShell from "../../../components/admin/AdminShell.astro";
import TreinoAtivo from "../../../components/admin/TreinoAtivo.svelte";

export const prerender = false;

const { membro } = Astro.locals;
const { id } = Astro.params;
---

<AdminShell title={`Treino #${id}`} voltar={{ href: "/admin/treinos", label: "Treinos" }}>
  <TreinoAtivo
    idTreino={Number(id)}
    souAdminSistema={membro.isAdminSistema}
    meuIdMembro={membro.id_membro}
    client:load
  />
</AdminShell>
