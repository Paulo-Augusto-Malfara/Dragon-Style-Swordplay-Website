---
import AdminShell from "../../../components/admin/AdminShell.astro";
import ModeracaoPerfil from "../../../components/admin/ModeracaoPerfil.svelte";
import AtivarNotificacoes from "../../../components/admin/AtivarNotificacoes.svelte";

export const prerender = false;

const { membro } = Astro.locals;
// Por ora só admin do sistema. As RPCs de aprovar/recusar aceitam organizador
// (nível 2), então abrir isso depois pra organizador e staff é mexer só aqui e
// nas duas linhas do AdminShell e do hub.
if (!membro.isAdminSistema) return Astro.redirect("/admin");
---

<AdminShell
  title="Aprovações"
  resumo="Foto e apelido que o membro escolhe só aparecem no site depois de passar por aqui."
>
  <AtivarNotificacoes client:load />
  <ModeracaoPerfil client:load />
</AdminShell>
