---
import AdminShell from "../../../components/admin/AdminShell.astro";
import AgendaEditor from "../../../components/admin/AgendaEditor.svelte";

export const prerender = false;

const { membro } = Astro.locals;
if (!membro.isOrganizador) return Astro.redirect("/admin");

const { id } = Astro.params;
---

<AdminShell
  title={id === "new" ? "Novo agendamento" : "Editar agendamento"}
  voltar={{ href: "/admin/agenda", label: "Agenda" }}
>
  <AgendaEditor id={id} meuIdMembro={membro.id_membro} client:load />
</AdminShell>
