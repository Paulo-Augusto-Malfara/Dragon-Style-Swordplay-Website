---
import AdminShell from "../../../components/admin/AdminShell.astro";
import AgendaList from "../../../components/admin/AgendaList.svelte";
import ReunioesList from "../../../components/admin/ReunioesList.svelte";

export const prerender = false;

const { membro } = Astro.locals;
if (!membro.isOrganizador) return Astro.redirect("/admin");
---

<AdminShell
  title="Agenda"
  resumo="Os próximos treinos do grupo e as reuniões de staff. Só o treino aparece no site público."
>
  <AgendaList client:load />
  <ReunioesList client:load />
</AdminShell>
