---
import AdminShell from "../../../components/admin/AdminShell.astro";
import AgendaList from "../../../components/admin/AgendaList.svelte";

export const prerender = false;

const { membro } = Astro.locals;
if (!membro.isOrganizador) return Astro.redirect("/admin");
---

<AdminShell
  title="Agenda de Treinos"
  resumo="O grupo não tem dia fixo, então é aqui que os próximos treinos são marcados."
>
  <AgendaList client:load />
</AdminShell>
