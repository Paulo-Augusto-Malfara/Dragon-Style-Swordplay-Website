---
import PageLayout from "../layouts/PageLayout.astro";
import { supabasePublic } from "../lib/supabase-public";
import { corDaFaixa } from "../lib/faixa";

export const prerender = false;

const { data } = await supabasePublic
  .from("v_ranking_nivel_geral")
  .select("*")
  .order("nivel_geral", { ascending: false });

const todos = data ?? [];
const organizadores = todos.filter((m) => m.auth_level <= 2);
const staff = todos.filter((m) => m.auth_level === 3);
const membros = todos.filter((m) => m.auth_level === null || m.auth_level >= 4);
const membrosAtivos = membros.filter((m) => m.status_ativo);
const membrosInativos = membros.filter((m) => !m.status_ativo);

const grupos = [
  { titulo: "Organizadores", lista: organizadores },
  { titulo: "Staff", lista: staff },
  { titulo: "Membros Ativos", lista: membrosAtivos },
  { titulo: "Membros Inativos", lista: membrosInativos },
].filter((g) => g.lista.length > 0);
---

<PageLayout
  title="Mural de Membros"
>
  <section>
    <p>
      No Mural de Membros é possível conferir todos os membros do Dragon
      Style e seus respectivos níveis, faixa e pontos de honra, organizados
      entre organizadores, staff, membros ativos e membros inativos.
    </p>
    <br />
  </section>

  {grupos.length === 0 ? (
    <p class="dashboard-empty">Nenhum membro veterano registrado ainda.</p>
  ) : (
    grupos.map(({ titulo, lista }) => (
      <>
        <h2>{titulo}</h2>
        <br />
        <section class="grid-mural">
          {lista.map((m) => (
            <div class="mural-card">
              <p class="mural-avatar">
                {m.foto_url ? <img src={m.foto_url} alt="" /> : m.nome.charAt(0).toUpperCase()}
              </p>
              <h3 class="mural-nome">{m.nome}</h3>
              {corDaFaixa(m.nome_faixa) && (
                <p class="mural-faixa">
                  <span class="mural-faixa-cor" style={`--faixa: ${corDaFaixa(m.nome_faixa)}`} />
                  Faixa {m.nome_faixa}
                </p>
              )}
              <p class="mural-numeros">
                <span><strong>{m.nivel_geral}</strong>Nível</span>
                <span><strong>{m.ph_total}</strong>PH</span>
              </p>
            </div>
          ))}
        </section>
        <br />
      </>
    ))
  )}
</PageLayout>
