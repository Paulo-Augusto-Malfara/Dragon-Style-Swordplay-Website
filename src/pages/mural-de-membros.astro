---
import PageLayout from "../layouts/PageLayout.astro";
import { supabasePublic } from "../lib/supabase-public";

export const prerender = false;

const { data } = await supabasePublic
  .from("v_ranking_nivel_geral")
  .select("*")
  .eq("status_ativo", true)
  .gte("nivel_geral", 1)
  .order("nivel_geral", { ascending: false });

const veteranos = data ?? [];
const organizadores = veteranos.filter((m) => m.auth_level <= 2);
const staff = veteranos.filter((m) => m.auth_level === 3);
const membros = veteranos.filter((m) => m.auth_level === null || m.auth_level >= 4);

const grupos = [
  { titulo: "Organizadores", lista: organizadores },
  { titulo: "Staff", lista: staff },
  { titulo: "Membros", lista: membros },
].filter((g) => g.lista.length > 0);
---

<PageLayout
  title="Mural de Membros"
  prev={{ href: "/ranking-por-classe", label: "Ranking por Classe" }}
  next={{ href: "/registro-de-treinos", label: "Registro de Treinos" }}
>
  <section>
    <p>
      No Mural de Membros é possível conferir todos os membros ativos e
      veteranos do Dragon Style e seus respectivos níveis, faixa e pontos
      de honra.
    </p>
    <br />
    <p>
      Para participar do Mural de Membros é preciso primeiramente se tornar
      veterano, então ganhará seu próprio card com suas informações.
    </p>
    <br />
  </section>

  {grupos.length === 0 ? (
    <p class="dashboard-empty">Nenhum membro veterano registrado ainda.</p>
  ) : (
    grupos.map(({ titulo, lista }) => (
      <>
        <h2>{titulo}</h2>
        <br />
        <section class="grid-mural">
          {lista.map((m) => (
            <div>
              <p class="mural-avatar">{m.nome.charAt(0).toUpperCase()}</p>
              <h2>{m.nome}</h2>
              <p><strong class="gold-title">Nível Geral:</strong> {m.nivel_geral}</p>
              <p><strong class="gold-title">Faixa:</strong> {m.nome_faixa ?? "-"}</p>
              <p><strong class="gold-title">PH's:</strong> {m.ph_total}</p>
            </div>
          ))}
        </section>
        <br />
      </>
    ))
  )}
</PageLayout>
