---
import PageLayout from "../layouts/PageLayout.astro";
import { supabasePublic } from "../lib/supabase-public";
import { corDaFaixa } from "../lib/faixa";
import Icon from "../components/Icon.astro";
import PerfilRapido from "../components/PerfilRapido.svelte";

export const prerender = false;

const { data } = await supabasePublic
  .from("v_ranking_nivel_geral")
  .select("*")
  .order("nivel_geral", { ascending: false });

const todos = data ?? [];
const organizadores = todos.filter((m) => m.auth_level <= 2);
const staff = todos.filter((m) => m.auth_level === 3);
const membros = todos.filter((m) => m.auth_level === null || m.auth_level >= 4);
const membrosAtivos = membros.filter((m) => m.status_ativo);
const membrosInativos = membros.filter((m) => !m.status_ativo);

const grupos = [
  { titulo: "Organizadores", lista: organizadores },
  { titulo: "Staff", lista: staff },
  { titulo: "Membros Ativos", lista: membrosAtivos },
  { titulo: "Membros Inativos", lista: membrosInativos },
].filter((g) => g.lista.length > 0);
---

<PageLayout
  title="Mural de Membros"
  description="Todos os membros do Dragon Style com nível, faixa e pontos de honra."
  resumo="Todo mundo do grupo com nível, faixa e pontos de honra, separado entre organizadores, staff e membros."
>

  {grupos.length === 0 ? (
    <p class="vazio">Nenhum membro veterano registrado ainda.</p>
  ) : (
    grupos.map(({ titulo, lista }) => (
      <>
        <h2>{titulo}</h2>
        <br />
        <section class="grid-mural">
          {lista.map((m) => (
            <div class="mural-card">
              {/* Canto de cima, fora do fluxo da coluna centralizada: no meio
                  ele empurraria a foto e o nome pra baixo em trinta cartões. */}
              <button
                type="button"
                class="mural-olho"
                data-perfil={m.id_membro}
                aria-label={`Ver perfil de ${m.nome}`}
                title={`Ver perfil de ${m.nome}`}
              >
                <Icon name="eye" />
              </button>
              <p class="mural-avatar">
                {m.foto_url ? <img src={m.foto_url} alt="" /> : m.nome.charAt(0).toUpperCase()}
              </p>
              <h3 class="mural-nome">{m.nome}</h3>
              {corDaFaixa(m.nome_faixa) && (
                <p class="mural-faixa">
                  <span class="mural-faixa-cor" style={`--faixa: ${corDaFaixa(m.nome_faixa)}`} />
                  Faixa {m.nome_faixa}
                </p>
              )}
              <p class="mural-numeros">
                <span><strong>{m.nivel_geral}</strong>Nível</span>
                <span><strong>{m.ph_total}</strong>PH</span>
              </p>
            </div>
          ))}
        </section>
        <br />
      </>
    ))
  )}
  <PerfilRapido client:idle />
</PageLayout>

<style>
  /* O cartão inteiro é flex centralizado (ver .grid-mural > div no global.css),
     então o botão sai do fluxo pra não mexer no que já está de pé. */
  .mural-card {
    position: relative;
  }

  .mural-olho {
    position: absolute;
    top: 6px;
    right: 6px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 9px;
    background: transparent;
    color: var(--ds-text-5);
    font-size: 1rem;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .mural-olho:hover {
    border-color: var(--ds-gold-dim);
    background: var(--ds-gold-wash);
    color: var(--ds-gold-light);
  }

  .mural-olho:focus-visible {
    outline: 2px solid var(--ds-gold-light);
    outline-offset: 2px;
  }
</style>
