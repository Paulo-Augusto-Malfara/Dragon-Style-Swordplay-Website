---
/**
 * Catálogo de modalidades.
 *
 * O filtro é por quantas pessoas a modalidade exige porque essa é a pergunta
 * real de quem está no campo: apareceram seis pessoas hoje, o que dá pra jogar?
 * Antes era preciso abrir uma por uma e ler os requisitos até achar uma que
 * coubesse.
 */
import PageLayout from "../layouts/PageLayout.astro";
import ModalidadeDetalhe from "../components/ModalidadeDetalhe.astro";
import { supabasePublic } from "../lib/supabase-public";

export const prerender = false;

const { data } = await supabasePublic
  .from("modalidades")
  .select("*")
  .order("id");

const modalidades = (data ?? []).map((m) => {
  // Coluna do banco, editável no painel. Antes isto era lido por heurística do
  // texto dos requisitos; zero segue significando "não informado", e nesse caso
  // a modalidade aparece em todos os filtros em vez de sumir de todos.
  const minimo = m.min_participantes ?? 0;
  return {
    ...m,
    minimo,
    // A linha fechada resume a modalidade: quantas pessoas e o formato. Duas
    // etiquetas, não todas, porque as primeiras do banco são as que dizem o
    // formato ("2 Times", "Duelo 1x1"); o resto aparece inteiro na janela.
    resumo: [minimo ? `${minimo}+ pessoas` : null, ...(m.tags ?? []).slice(0, 2)]
      .filter(Boolean)
      .join(" · "),
  };
});

// As faixas saem do próprio acervo, não de uma lista chutada: se um dia entrar
// uma modalidade de 30 pessoas, a faixa "20+" continua correta sem ninguém
// lembrar de vir aqui mexer.
const faixas = [
  { id: "", label: "Todas" },
  { id: "ate5", label: "Até 5" },
  { id: "10", label: "10+" },
  { id: "15", label: "15+" },
  { id: "20", label: "20+" },
];
---

<PageLayout
  title="Modalidades"
  description="Os jogos de combate do Dragon Style, filtrados por quantas pessoas cada um precisa."
  resumo="Modalidades são os jogos que dão dinâmica ao combate. Filtre por quantas pessoas apareceram e veja o que dá para jogar hoje."
>
  <section class="mod-filtros" aria-label="Filtrar por número de participantes">
    <p class="mod-filtros-rotulo">Quantos vieram hoje?</p>
    <div class="mod-chips" role="group">
      {
        faixas.map((f) => (
          <button
            type="button"
            class:list={["mod-chip", { ativo: f.id === "" }]}
            data-faixa={f.id}
          >
            {f.label}
          </button>
        ))
      }
    </div>
    <p class="mod-conta" aria-live="polite" id="mod-conta">
      {modalidades.length} modalidades
    </p>
  </section>

  <section>
    <ul class="mod-grade" id="mod-grade">
      {
        modalidades.map((m) => (
          <li class="mod-item" data-minimo={m.minimo}>
            {/* Link pro #slug, sem script: quem abre a janela é o BaseLayout,
                olhando o hash. É o mesmo caminho do resultado da busca. */}
            <a class="mod-card" href={`#${m.slug}`}>
              <span class="mod-nome">{m.title}</span>
              {m.resumo && <span class="mod-resumo">{m.resumo}</span>}
              <span class="mod-mais">Ver regras →</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mod-vazio" id="mod-vazio" hidden>
      Nenhuma modalidade para esse número. Toque em <strong>Todas</strong> para
      ver o acervo inteiro.
    </p>
  </section>

  {/* Fora da grade de propósito: o filtro esconde o <li>, e um <dialog> dentro
      de um pai com `display: none` não abre nem indo pelo #hash. */}
  {
    modalidades.map((m) => (
      <ModalidadeDetalhe
        id={m.slug}
        title={m.title}
        minimo={m.minimo}
        tags={m.tags ?? []}
        descricao={m.description}
        objetivo={m.objective}
        pontuacao={m.scoring_respawn}
        requisitos={m.requirements}
        variacoes={m.variations}
      />
    ))
  }
</PageLayout>

<style>
  /* Gruda abaixo do cabeçalho: no celular a lista é longa e rolar de volta ao
     topo pra trocar o filtro é o tipo de atrito que faz a pessoa desistir. */
  .mod-filtros {
    position: sticky;
    top: var(--ds-header-h);
    z-index: 3;
    margin-bottom: 1.4em;
    padding: 12px 0;
    background: var(--ds-bg);
    border-bottom: 1px solid var(--ds-line);
  }

  .mod-filtros-rotulo {
    margin: 0 0 10px;
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ds-text-4);
  }

  .mod-chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: none;
  }

  .mod-chips::-webkit-scrollbar {
    display: none;
  }

  .mod-chip {
    flex: none;
    min-height: 38px;
    padding: 0 15px;
    border: 1px solid var(--ds-line-strong);
    border-radius: 999px;
    background: none;
    color: var(--ds-text-2);
    font-size: 0.84rem;
    cursor: pointer;
  }

  .mod-chip:hover,
  .mod-chip:focus-visible {
    border-color: var(--ds-gold-dim);
  }

  .mod-chip.ativo {
    border-color: var(--ds-gold);
    background: var(--ds-gold-wash);
    color: var(--ds-gold-light);
  }

  .mod-conta {
    margin: 10px 0 0;
    font-size: 0.76rem;
    color: var(--ds-text-5);
  }

  /* ======== GRADE ======== */

  /* Mesma grade do catálogo de equipamentos e do de classes, com a coluna um
     pouco mais larga porque aqui o card é texto, sem imagem pra dar altura. */
  .mod-grade {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(215px, 1fr));
    gap: 12px;
  }

  .mod-item[hidden] {
    display: none;
  }

  .mod-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 14px 16px;
    border: 1px solid var(--ds-line);
    border-radius: 12px;
    background: var(--ds-surface-solid);
    text-decoration: none;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }

  .mod-card:hover,
  .mod-card:focus-visible {
    border-color: var(--ds-gold-dim);
    transform: translateY(-2px);
  }

  .mod-nome {
    font-family: var(--ds-font-display);
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.2rem);
    line-height: 1.2;
    color: var(--ds-text-1);
  }

  .mod-resumo {
    font-size: 0.78rem;
    color: var(--ds-text-4);
  }

  /* No rodapé do card pra todos alinharem na mesma altura, como em /classes. */
  .mod-mais {
    margin-top: auto;
    padding-top: 10px;
    font-size: 0.76rem;
    color: var(--ds-gold-light);
  }

  .mod-vazio {
    padding: 40px 0;
    text-align: center;
    color: var(--ds-text-4);
  }
</style>

<script>
  const grade = document.getElementById("mod-grade");
  const conta = document.getElementById("mod-conta");
  const vazio = document.getElementById("mod-vazio");
  const chips = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".mod-chip"),
  );

  if (grade && conta && vazio && chips.length) {
    const itens = Array.from(
      grade.querySelectorAll<HTMLElement>(".mod-item"),
    );

    // "Até 5" é teto e o resto é piso, então a comparação inverte no primeiro
    // caso. Um único mapa evita espalhar essa regra por três lugares.
    const cabe = (minimo: number, faixa: string) => {
      if (!faixa) return true;
      if (faixa === "ate5") return minimo <= 5;
      return minimo >= Number(faixa);
    };

    function filtrar(faixa: string) {
      let visiveis = 0;
      for (const item of itens) {
        const minimo = Number(item.dataset.minimo ?? 0);
        const mostra = cabe(minimo, faixa);
        item.hidden = !mostra;
        if (mostra) visiveis++;
      }
      conta!.textContent =
        visiveis === 1 ? "1 modalidade" : `${visiveis} modalidades`;
      vazio!.hidden = visiveis > 0;
    }

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        for (const outro of chips) outro.classList.toggle("ativo", outro === chip);
        filtrar(chip.dataset.faixa ?? "");
      });
    }
  }
</script>
