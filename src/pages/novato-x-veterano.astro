---
import { getEntry, render } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import SumarioPagina from "../components/SumarioPagina.astro";

const entry = await getEntry("progressaoInfo", "novato-x-veterano");
const { Content, headings } = await render(entry);
---

<PageLayout
  title={entry.data.title}
  resumo="Quatro treinos separam o novato do veterano. Aqui está o que muda quando você atravessa essa linha."
>
  <SumarioPagina {headings} />
  <section class="prosa">
    <Content />
  </section>
</PageLayout>
