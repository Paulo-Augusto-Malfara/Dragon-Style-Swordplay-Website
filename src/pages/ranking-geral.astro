---
import PageLayout from "../layouts/PageLayout.astro";
import { supabasePublic } from "../lib/supabase-public";
import RankingLista from "../components/RankingLista.astro";

export const prerender = false;

const { data: rankingRaw } = await supabasePublic
  .from("v_ranking_nivel_geral")
  .select("*");

const { data: porClasse } = await supabasePublic
  .from("v_ranking_por_classe")
  .select("id_membro, id_classe, nivel_por_classe, treinos_por_classe");

const nivelClassePorMembro = new Map<number, number>();
const treinosPorMembro = new Map<number, number>();
for (const row of porClasse ?? []) {
  treinosPorMembro.set(
    row.id_membro,
    (treinosPorMembro.get(row.id_membro) ?? 0) + (row.treinos_por_classe ?? 0)
  );
  if (row.id_classe === 11) continue; // Básico é gate de veterano, não conta pro nível de classe
  nivelClassePorMembro.set(
    row.id_membro,
    (nivelClassePorMembro.get(row.id_membro) ?? 0) + (row.nivel_por_classe ?? 0)
  );
}

const ranking = (rankingRaw ?? []).map((m) => ({
  ...m,
  nivel_classe_total: nivelClassePorMembro.get(m.id_membro) ?? 0,
  treinos_total: treinosPorMembro.get(m.id_membro) ?? 0,
}));

const SORTS = {
  geral: { label: "Nível Geral", key: "nivel_geral" },
  classe: { label: "Nível de Classe", key: "nivel_classe_total" },
  honra: { label: "Pontos de Honra", key: "ph_total" },
  treinos: { label: "Treinos", key: "treinos_total" },
} as const;
type SortKey = keyof typeof SORTS;
const sortPedido = Astro.url.searchParams.get("sort") ?? "geral";
const sort: SortKey = sortPedido in SORTS ? (sortPedido as SortKey) : "geral";
ranking.sort((a, b) => b[SORTS[sort].key] - a[SORTS[sort].key]);

const PAGE_SIZE = 25;
const totalPaginas = Math.max(1, Math.ceil(ranking.length / PAGE_SIZE));
const paginaPedida = Number(Astro.url.searchParams.get("page") ?? "1");
const pagina = Number.isFinite(paginaPedida)
  ? Math.min(Math.max(1, Math.trunc(paginaPedida)), totalPaginas)
  : 1;
const inicio = (pagina - 1) * PAGE_SIZE;
const paginaAtual = ranking.slice(inicio, inicio + PAGE_SIZE);
---

<PageLayout
  title="Ranking Geral"
  description="O ranking de todos os membros do Dragon Style por nível geral, nível de classe, treinos e pontos de honra."
  resumo="Todo mundo que treina, em ordem. Toque em um critério para reordenar a lista."
>
  <nav class="ranking-quick-nav" aria-label="Ordenar ranking">
    {Object.entries(SORTS).map(([key, { label }]) => (
      <a
        class={`btn btn-sm${key === sort ? " btn-primary" : ""}`}
        href={`?sort=${key}`}
        aria-current={key === sort ? "page" : undefined}
      >
        {label}
      </a>
    ))}
  </nav>
  <RankingLista
    colunas={4}
    itens={paginaAtual.map((m, i) => ({
      posicao: inicio + i + 1,
      nome: m.nome,
      fotoUrl: m.foto_url,
      nomeFaixa: m.nome_faixa,
      metricas: [
        { rotulo: "Geral", valor: m.nivel_geral },
        { rotulo: "Classe", valor: m.nivel_classe_total },
        { rotulo: "Treinos", valor: m.treinos_total },
        { rotulo: "PH", valor: m.ph_total },
      ],
    }))}
  />
  {totalPaginas > 1 && (
    <nav class="ranking-pagination" aria-label="Páginas do ranking">
      {pagina > 1 && (
        <a class="btn btn-sm" href={`?sort=${sort}&page=${pagina - 1}`} rel="prev">‹</a>
      )}
      {Array.from({ length: totalPaginas }, (_, idx) => idx + 1).map((p) => (
        <a
          class={`btn btn-sm${p === pagina ? " btn-primary" : ""}`}
          href={`?sort=${sort}&page=${p}`}
          aria-current={p === pagina ? "page" : undefined}
        >
          {p}
        </a>
      ))}
      {pagina < totalPaginas && (
        <a class="btn btn-sm" href={`?sort=${sort}&page=${pagina + 1}`} rel="next">›</a>
      )}
    </nav>
  )}
</PageLayout>
