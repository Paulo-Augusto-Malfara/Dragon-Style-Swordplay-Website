---
import { getEntry, render } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import SumarioPagina from "../components/SumarioPagina.astro";

const entry = await getEntry("regulamentos", "regras-de-combate");
const { Content, headings } = await render(entry);
---

<PageLayout
  title={entry.data.title}
  resumo="Onde vale acertar, onde não vale, e por que a força não decide nada aqui."
>
  <SumarioPagina {headings} />
  <section class="prosa">
    <Content />
  </section>
</PageLayout>
