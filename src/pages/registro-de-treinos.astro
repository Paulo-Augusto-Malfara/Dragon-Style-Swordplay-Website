---
import PageLayout from "../layouts/PageLayout.astro";
import TreinoCard from "../components/TreinoCard.astro";
import { supabasePublic } from "../lib/supabase-public";

export const prerender = false;

const { data: registros } = await supabasePublic
  .from("v_registro_treinos")
  .select("*")
  .order("data_treino", { ascending: false })
  .order("nome")
  .limit(200);

interface Registro {
  id_treino: number;
  data_treino: string;
  nome: string;
  foto_url: string | null;
  nome_classe: string;
  nivel_geral: number;
  subiu_nivel_geral: boolean;
  subida_nivel_geral: number;
  nivel_classe: number;
  subiu_nivel_classe: boolean;
}

const porTreino = new Map<number, { data_treino: string; attendees: Registro[] }>();
for (const r of (registros ?? []) as Registro[]) {
  if (!porTreino.has(r.id_treino)) {
    porTreino.set(r.id_treino, { data_treino: r.data_treino, attendees: [] });
  }
  porTreino.get(r.id_treino)!.attendees.push(r);
}
const treinos = [...porTreino.entries()].sort((a, b) => b[1].data_treino.localeCompare(a[1].data_treino));
---

<PageLayout
  title="Registro de Treinos"
  prev={{ href: "/mural-de-membros", label: "Mural de Membros" }}
  next={{ href: "/novato-x-veterano", label: "Novato x Veterano" }}
>
  <section>
    <p>
      Confira abaixo os últimos treinos registrados: quem participou, em
      qual classe, e quem subiu de nível.
    </p>
    <br />
  </section>
  {treinos.length === 0 ? (
    <p class="dashboard-empty">Nenhum treino registrado ainda.</p>
  ) : (
    <div class="modalidades modalidades-grid treinos-grid">
      {treinos.map(([idTreino, { data_treino, attendees }]) => (
        <TreinoCard idTreino={idTreino} dataTreino={data_treino} attendees={attendees} />
      ))}
    </div>
  )}
</PageLayout>
