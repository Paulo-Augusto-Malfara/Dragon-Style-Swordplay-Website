---
import PageLayout from "../layouts/PageLayout.astro";
import TreinoCard from "../components/TreinoCard.astro";
import Paginacao from "../components/Paginacao.astro";
import { supabasePublic } from "../lib/supabase-public";

export const prerender = false;

interface Registro {
  id_treino: number;
  data_treino: string;
  nome: string;
  foto_url: string | null;
  nome_classe: string;
  nivel_geral: number;
  subiu_nivel_geral: boolean;
  subida_nivel_geral: number;
  nivel_classe: number;
  subiu_nivel_classe: boolean;
}

const POR_PAGINA = 10;
const pedida = Math.max(1, Number(Astro.url.searchParams.get("pagina")) || 1);

// v_registro_treinos tem uma linha por presença, não por treino: cortar em 200
// linhas derrubava pela metade o treino que caía na borda (o 71 aparecia com 2
// de 17 presentes) e sumia com todos os anteriores. A página de treinos sai da
// v_treinos_publicos, que é uma linha por treino, e só então se buscam as
// presenças desses 10.
const { data: treinos, count } = await supabasePublic
  .from("v_treinos_publicos")
  .select("id_treino, data_treino", { count: "exact" })
  .order("data_treino", { ascending: false })
  .order("id_treino", { ascending: false })
  .range((pedida - 1) * POR_PAGINA, pedida * POR_PAGINA - 1);

const totalPaginas = Math.max(1, Math.ceil((count ?? 0) / POR_PAGINA));
const pagina = Math.min(pedida, totalPaginas);
const daPagina = treinos ?? [];

// ?pagina=9 numa lista de 2 páginas: sem isso a tela diz "nenhum treino
// registrado ainda", que é mentira, e sem link nenhum pra voltar.
if (daPagina.length === 0 && pedida > 1) return Astro.redirect("/registro-de-treinos");

const { data: registros } = daPagina.length
  ? await supabasePublic
      .from("v_registro_treinos")
      .select("*")
      .in(
        "id_treino",
        daPagina.map((t) => t.id_treino),
      )
  : { data: [] };

const porTreino = new Map<number, Registro[]>();
for (const r of (registros ?? []) as Registro[]) {
  if (!porTreino.has(r.id_treino)) porTreino.set(r.id_treino, []);
  porTreino.get(r.id_treino)!.push(r);
}
for (const attendees of porTreino.values()) {
  attendees.sort((a, b) => {
    if (a.subiu_nivel_geral !== b.subiu_nivel_geral) return a.subiu_nivel_geral ? -1 : 1;
    return b.nivel_geral - a.nivel_geral;
  });
}
---

<PageLayout
  title="Registro de Treinos"
  description="Histórico dos treinos do Dragon Style, com presenças, classes e quem subiu de nível."
  resumo="Os treinos já registrados: quem participou, em qual classe, e quem subiu de nível."
>
  {daPagina.length === 0 ? (
    <p class="vazio">Nenhum treino registrado ainda.</p>
  ) : (
    <div class="tr-lista">
      {daPagina.map((t) => (
        <TreinoCard
          idTreino={t.id_treino}
          dataTreino={t.data_treino}
          attendees={porTreino.get(t.id_treino) ?? []}
        />
      ))}
    </div>
  )}

  <Paginacao
    pagina={pagina}
    totalPaginas={totalPaginas}
    base="/registro-de-treinos"
    rotulo="Páginas do registro de treinos"
  />
</PageLayout>

<style>
  .tr-lista {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
</style>
