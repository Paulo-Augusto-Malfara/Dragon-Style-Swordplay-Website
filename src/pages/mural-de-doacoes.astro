---
import PageLayout from "../layouts/PageLayout.astro";
import { supabasePublic } from "../lib/supabase-public";
import RankingLista from "../components/RankingLista.astro";

export const prerender = false;

const { data: doacoes } = await supabasePublic
  .from("v_historico_doacoes")
  .select("*")
  .order("data_doacao", { ascending: false })
  .order("id_doacao", { ascending: false });

const PAGE_SIZE = 25;
const totalPaginas = Math.max(1, Math.ceil((doacoes ?? []).length / PAGE_SIZE));
const paginaPedida = Number(Astro.url.searchParams.get("page") ?? "1");
const pagina = Number.isFinite(paginaPedida)
  ? Math.min(Math.max(1, Math.trunc(paginaPedida)), totalPaginas)
  : 1;
const inicio = (pagina - 1) * PAGE_SIZE;
const paginaAtual = (doacoes ?? []).slice(inicio, inicio + PAGE_SIZE);

/* "R$ 10.00" era ponto decimal, que não é como se escreve dinheiro em
   português. O toFixed(2) não sabe disso, o Intl sabe. */
const reais = (v: unknown) =>
  Number(v).toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
---

<PageLayout
  title="Mural de Doações"
  description="Histórico das doações recebidas pelo Dragon Style Swordplay e Eventos."
  resumo="O histórico de doações recebidas pelo grupo, registradas pelos organizadores."
>
  {(doacoes ?? []).length === 0 ? (
    <p class="vazio">Nenhuma doação registrada ainda.</p>
  ) : (
    /* A mesma lista do Ranking, sem a coluna de colocação: doação não tem
       posição, é histórico. Era a última tabela pública com a moldura dourada
       e o cabeçalho em versalete do site antigo, e a página inteira destoava
       das outras duas que mostram pessoa, foto e números. */
    <RankingLista
      colunas={3}
      perfil={false}
      itens={paginaAtual.map((d) => ({
        idMembro: d.id_membro,
        nome: d.nome,
        fotoUrl: d.foto_url,
        metricas: [
          {
            rotulo: "Data",
            valor: new Date(d.data_doacao + "T00:00:00").toLocaleDateString("pt-BR", {
              day: "2-digit",
              month: "2-digit",
              year: "2-digit",
            }),
          },
          { rotulo: "Valor", valor: reais(d.valor) },
          { rotulo: "Total doado", valor: reais(d.total_doado) },
        ],
      }))}
    />
  )}
  {totalPaginas > 1 && (
    <nav class="ranking-pagination" aria-label="Páginas do mural de doações">
      {pagina > 1 && (
        <a class="chip" href={`?page=${pagina - 1}`} rel="prev" aria-label="Página anterior">‹</a>
      )}
      {Array.from({ length: totalPaginas }, (_, idx) => idx + 1).map((p) => (
        <a
          class:list={["chip", p === pagina && "ativo"]}
          href={`?page=${p}`}
          aria-current={p === pagina ? "page" : undefined}
        >
          {p}
        </a>
      ))}
      {pagina < totalPaginas && (
        <a class="chip" href={`?page=${pagina + 1}`} rel="next" aria-label="Próxima página">›</a>
      )}
    </nav>
  )}
</PageLayout>
