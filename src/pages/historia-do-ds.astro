---
import { getEntry, render } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import SumarioPagina from "../components/SumarioPagina.astro";

const entry = await getEntry("sobreNos", "historia-do-ds");
const { Content, headings } = await render(entry);
---

<PageLayout
  title={entry.data.title}
  resumo="De 2008 até hoje, ano a ano: como o grupo nasceu, quem o manteve de pé e o que mudou pelo caminho."
>
  <SumarioPagina {headings} />
  <section class="prosa">
    <Content />
  </section>
</PageLayout>
