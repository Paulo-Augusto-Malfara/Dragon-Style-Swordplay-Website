---
import PageLayout from "../layouts/PageLayout.astro";
import { supabasePublic } from "../lib/supabase-public";
import { dataDoPost, resumoDoPost } from "../lib/posts";

export const prerender = false;

// Só o que a lista mostra: o corpo inteiro de sete novidades viria junto sem
// necessidade, e a chamada sai das primeiras linhas dele.
const { data: posts } = await supabasePublic
  .from("posts")
  .select("slug, title, body, published_at")
  .eq("is_published", true)
  .order("published_at", { ascending: false });
---

<PageLayout
  title="Novidades"
  description="Avisos, mudanças de regra e atualizações do Dragon Style Swordplay."
  resumo="Avisos, recados e o que aconteceu de novo no grupo. Cada novidade tem a sua página."
>
  {
    (posts ?? []).length === 0 ? (
      <p class="vazio">Nada publicado por enquanto. Quando tiver, aparece aqui.</p>
    ) : (
      <ul class="post-lista">
        {(posts ?? []).map((post) => (
          // O id mantém de pé o link antigo `/novidades#slug`, que a home usou
          // enquanto tudo era uma página só: ele agora para no cartão certo da
          // lista em vez de morrer no topo.
          <li id={post.slug}>
            <a class="post-cartao" href={`/novidades/${post.slug}`}>
              {dataDoPost(post.published_at) && <span class="post-data">{dataDoPost(post.published_at)}</span>}
              <strong class="post-titulo">{post.title}</strong>
              <span class="post-resumo">{resumoDoPost(post.body)}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</PageLayout>
