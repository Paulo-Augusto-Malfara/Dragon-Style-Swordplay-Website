---
import sanitizeHtml from "sanitize-html";
import PageLayout from "../layouts/PageLayout.astro";
import { supabasePublic } from "../lib/supabase-public";

export const prerender = false;

const { data: posts } = await supabasePublic
  .from("posts")
  .select("*")
  .eq("is_published", true)
  .order("published_at", { ascending: false });

// ponytail: posts.body is admin-authored HTML from a free-text textarea (see
// PostEditor.svelte); sanitized here so a compromised/careless admin account
// can't slip a stored XSS payload to every visitor of this page.
const sanitize = (html: string) =>
  sanitizeHtml(html, {
    allowedTags: sanitizeHtml.defaults.allowedTags.concat(["img", "h1", "h2"]),
    allowedAttributes: {
      ...sanitizeHtml.defaults.allowedAttributes,
      img: ["src", "alt", "width", "height"],
    },
  });
---

<PageLayout
  title="Novidades"
  resumo="Avisos, recados e o que aconteceu de novo no grupo."
>
  {
    (posts ?? []).map((post) => (
      <section class="news" id={post.slug}>
        <h3>{post.title}</h3>
        <Fragment set:html={sanitize(post.body)} />
      </section>
    ))
  }
</PageLayout>
