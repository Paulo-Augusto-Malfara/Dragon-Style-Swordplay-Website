---
import { getEntry, render } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";

const entry = await getEntry("progressaoInfo", "nivel-geral");
const { Content } = await render(entry);
---

<PageLayout title={entry.data.title} prev={entry.data.prev} next={entry.data.next}>
  <section>
    <Content />
  </section>
</PageLayout>
