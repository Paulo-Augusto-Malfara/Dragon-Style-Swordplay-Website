---
import { getEntry, render } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import SumarioPagina from "../components/SumarioPagina.astro";

const entry = await getEntry("progressaoInfo", "nivel-geral");
const { Content, headings } = await render(entry);
---

<PageLayout
  title={entry.data.title}
  resumo="A conta que mede sua experiência total no grupo, e que decide em qual graduação você está."
>
  <SumarioPagina {headings} />
  <section class="prosa">
    <Content />
  </section>
</PageLayout>
