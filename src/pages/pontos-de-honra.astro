---
import { getEntry, render } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import SumarioPagina from "../components/SumarioPagina.astro";

const entry = await getEntry("progressaoInfo", "pontos-de-honra");
const { Content, headings } = await render(entry);
---

<PageLayout title={entry.data.title}>
  <SumarioPagina {headings} />
  <section>
    <Content />
  </section>
</PageLayout>
