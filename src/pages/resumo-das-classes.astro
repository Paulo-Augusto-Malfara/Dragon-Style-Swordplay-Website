---
/**
 * Catálogo das dez classes.
 *
 * Cada card carrega o que decide a escolha (armamento, alcance, dificuldade) em
 * vez do parágrafo de apresentação que estava aqui antes, e esse dado sai do
 * frontmatter, o mesmo que monta a ficha da página individual.
 *
 * O guia de escolha existe porque a pergunta de quem chega não é "o que é o
 * Templário", é "quero escudo, qual classe eu pego?".
 */
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import CatalogoLinks from "../components/CatalogoLinks.astro";

const classes = (await getCollection("classes")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, "pt-BR"),
);

// O href sai da coleção, então renomear um arquivo nunca deixa link quebrado.
const slugDe = Object.fromEntries(classes.map((c) => [c.data.title, c.id]));

const guia = [
  { querer: "Estou começando agora", nomes: ["Guerreiro", "Viking"] },
  {
    querer: "Quero escudo e linha de frente",
    nomes: ["Guerreiro", "Viking", "Templário", "Hoplita"],
  },
  { querer: "Quero alcance no corpo a corpo", nomes: ["Lanceiro", "Cavaleiro", "Hoplita"] },
  { querer: "Quero atacar de longe", nomes: ["Arqueiro"] },
  {
    querer: "Quero uma arma em cada mão",
    nomes: ["Bárbaro", "Espadachim", "Sicário"],
  },
  { querer: "Quero vencer quem usa escudo", nomes: ["Bárbaro", "Templário"] },
];

const sistema = [
  {
    href: "/como-funciona",
    label: "Sistema de Classes",
    desc: "Como a classe sobe de nível e o que isso libera.",
  },
  {
    href: "/bonus-nivel-3",
    label: "Bônus de Nível 3",
    desc: "Por que cada classe guarda parte do arsenal para o nível 3.",
  },
  {
    href: "/mentor-de-classe",
    label: "Mentor de Classe",
    desc: "O título que vem no nível 5 e o que se espera de um mentor.",
  },
];
---

<PageLayout
  title="Classes"
  description="As 10 classes do Dragon Style, com armamento, alcance e dificuldade de cada uma."
  resumo="São 10 classes, e a classe define quais armas você pode levar para o treino. Escolha uma para começar, trocar depois é livre."
>
  <section class="cl-guia" aria-label="Guia de escolha">
    <h2>Não sabe qual escolher?</h2>
    <dl>
      {
        guia.map((g) => (
          <div>
            <dt>{g.querer}</dt>
            <dd>
              {g.nomes.map((n, i) => (
                <>
                  {i > 0 && ", "}
                  <a href={`/${slugDe[n]}`}>{n}</a>
                </>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="cl-guia-obs">
      Nenhuma escolha é definitiva: você pode registrar treino com uma classe
      hoje e outra na semana que vem, sem perder o que já acumulou.
    </p>
  </section>

  <h2 class="cl-titulo">As 10 classes</h2>

  {/* O comparador aparece sozinho ao marcar a segunda classe. O design tinha um
      botão "Comparar classes" que ligava um modo e mudava o que o card faz ao
      ser tocado; aqui o card continua sendo só um link e a seleção é um
      controle separado. Um estado a menos pra entender, e o card não muda de
      significado no meio do uso. */}
  <section class="cl-comparador" id="cl-comparador" hidden aria-live="polite">
    <div class="cl-comparador-topo">
      <h3>Comparando</h3>
      <button type="button" id="cl-limpar" class="cl-limpar">Limpar</button>
    </div>
    <div class="cl-tabela-rolagem">
      <table class="cl-tabela" id="cl-tabela"></table>
    </div>
  </section>

  <ul class="cl-grade">
    {
      classes.map((c) => (
        <li>
          <a class="cl-card" href={`/${c.id}`}>
            <img src={c.data.image} alt={c.data.imageAlt} loading="lazy" />
            <span class="cl-nome">{c.data.title}</span>
            <span class="cl-resumo">{c.data.resumo}</span>
            <span class="cl-armas">{c.data.armamento}</span>
            <span class="cl-meta">
              Alcance {c.data.alcance.toLowerCase()} · Dificuldade{" "}
              {c.data.dificuldade.toLowerCase()}
            </span>
            <span class="cl-mais">Ver classe completa</span>
            {c.data.selo && <span class="cl-selo">{c.data.selo}</span>}
          </a>
          <label class="cl-cmp">
            <input type="checkbox" data-cmp value={c.data.title} />
            <span>Comparar</span>
          </label>
        </li>
      ))
    }
  </ul>

  <script
    type="application/json"
    id="cl-dados"
    set:html={JSON.stringify(
      classes.map((c) => ({
        nome: c.data.title,
        href: `/${c.id}`,
        Armas: c.data.armamento,
        Alcance: c.data.alcance,
        Dificuldade: c.data.dificuldade,
        "Em uma frase": c.data.resumo,
      })),
    )}
  />

  <CatalogoLinks titulo="Sobre o sistema de classes" itens={sistema} />
</PageLayout>

<style>
  /* ======== GUIA DE ESCOLHA ======== */

  .cl-guia {
    margin-bottom: 30px;
    padding: 16px 18px;
    border: 1px solid var(--ds-line);
    border-radius: 12px;
    background: var(--ds-surface);
  }

  .cl-guia h2 {
    margin: 0 0 12px;
    font-size: 1.15rem;
  }

  .cl-guia dl {
    margin: 0;
  }

  .cl-guia dl > div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 8px 0;
    border-top: 1px solid var(--ds-line);
  }

  .cl-guia dt {
    font-size: 0.9rem;
    color: var(--ds-text-3);
  }

  .cl-guia dd {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  /* Filho direto: `a` solto pegaria qualquer link aninhado mais fundo. */
  .cl-guia dd > a {
    color: var(--ds-gold-light);
    text-decoration: none;
    border-bottom: 1px solid var(--ds-gold-dim);
  }

  .cl-guia dd > a:hover {
    color: var(--ds-gold);
  }

  .cl-guia-obs {
    width: 100%;
    margin: 14px 0 0;
    font-size: 0.86rem;
    color: var(--ds-text-4);
  }

  .cl-titulo {
    margin: 0 0 14px;
    font-size: 1.15rem;
  }

  /* ======== GRADE DE CLASSES ======== */

  .cl-grade {
    list-style: none;
    margin: 0 0 30px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 12px;
  }

  .cl-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    height: 100%;
    padding: 14px;
    border: 1px solid var(--ds-line);
    border-radius: 10px;
    background: var(--ds-surface-solid);
    text-decoration: none;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }

  .cl-card:hover,
  .cl-card:focus-visible {
    border-color: var(--ds-gold-dim);
    transform: translateY(-2px);
  }

  .cl-card > img {
    width: 100%;
    height: 108px;
    object-fit: contain;
    margin-bottom: 6px;
  }

  .cl-nome {
    font-family: var(--ds-font-display);
    font-size: 1.1rem;
    color: var(--ds-text-1);
  }

  .cl-resumo {
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--ds-text-3);
  }

  .cl-armas {
    font-size: 0.84rem;
    line-height: 1.4;
    color: var(--ds-gold);
  }

  .cl-meta {
    font-size: 0.76rem;
    color: var(--ds-text-4);
  }

  /* Empurrado para o rodapé do card, para que todos alinhem na mesma altura. */
  .cl-mais {
    margin-top: auto;
    padding-top: 8px;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ds-gold-light);
  }

  /* Encosta no canto e encolhe com o próprio texto, nunca estica no card. */
  .cl-selo {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 3px 8px;
    border: 1px solid var(--ds-gold-dim);
    border-radius: 999px;
    background: var(--ds-gold-wash);
    font-size: 0.66rem;
    color: var(--ds-gold-light);
  }

  @media (max-width: 560px) {
    .cl-guia dl > div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  /* ======== COMPARADOR ======== */

  .cl-grade > li {
    position: relative;
  }

  /* Fica fora do <a>: link dentro de link é markup inválido, e um clique em
     "Comparar" não pode navegar sem querer. */
  .cl-cmp {
    position: absolute;
    left: 8px;
    bottom: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border: 1px solid var(--ds-line-strong);
    border-radius: 999px;
    background: var(--ds-bg-alt);
    font-size: 0.68rem;
    color: var(--ds-text-4);
    cursor: pointer;
    /* Alvo de toque de 44px sem inflar a pílula, que ficaria desproporcional
       dentro do card. */
    min-height: 32px;
  }

  .cl-cmp:hover,
  .cl-cmp:focus-within {
    border-color: var(--ds-gold-dim);
    color: var(--ds-text-2);
  }

  .cl-cmp input {
    width: 13px;
    height: 13px;
    margin: 0;
    accent-color: var(--ds-gold);
  }

  .cl-cmp:has(input:checked) {
    border-color: var(--ds-gold);
    background: var(--ds-gold-wash);
    color: var(--ds-gold-light);
  }

  .cl-comparador {
    margin: 0 0 1.6em;
    border: 1px solid var(--ds-gold-dim);
    border-radius: 16px;
    background: var(--ds-surface);
  }

  .cl-comparador[hidden] {
    display: none;
  }

  .cl-comparador-topo {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--ds-line);
  }

  .cl-comparador-topo h3 {
    margin: 0;
    font-family: var(--ds-font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ds-gold-deep);
  }

  .cl-limpar {
    margin-left: auto;
    padding: 5px 12px;
    border: 1px solid var(--ds-line-strong);
    border-radius: 999px;
    background: none;
    color: var(--ds-text-3);
    font-size: 0.72rem;
    cursor: pointer;
  }

  .cl-limpar:hover {
    border-color: var(--ds-gold-dim);
    color: var(--ds-gold-light);
  }

  /* Três colunas não cabem na largura de um celular sem espremer o texto até
     virar uma palavra por linha. Rola na horizontal dentro do próprio cartão,
     que é a única parte da página que rola de lado. */
  .cl-tabela-rolagem {
    overflow-x: auto;
  }

  .cl-tabela {
    width: 100%;
    min-width: 420px;
    border-collapse: collapse;
  }

  .cl-tabela th,
  .cl-tabela td {
    padding: 11px 16px;
    border-bottom: 1px solid var(--ds-line);
    text-align: left;
    vertical-align: top;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .cl-tabela tr:last-child th,
  .cl-tabela tr:last-child td {
    border-bottom: 0;
  }

  /* A coluna de rótulos é cabeçalho de linha, não dado: fica estreita, fria e
     não compete com os valores que estão sendo comparados. */
  .cl-tabela tbody th {
    width: 108px;
    font-weight: 400;
    font-size: 0.74rem;
    color: var(--ds-text-4);
  }

  .cl-tabela thead th {
    font-family: var(--ds-font-display);
    font-size: 0.95rem;
    color: var(--ds-gold-light);
    border-bottom-color: var(--ds-line-strong);
  }

  .cl-tabela td {
    border-left: 1px solid var(--ds-line);
    color: var(--ds-text-2);
  }

  .cl-tabela thead th + th {
    border-left: 1px solid var(--ds-line);
  }
</style>

<script>
  /**
   * Comparador de classes. Aparece ao marcar a segunda, some ao sobrar menos de
   * duas, e no teto de três a mais antiga sai pra abrir vaga, que é o que o
   * design faz. Sem teto a tabela vira uma planilha de dez colunas no celular.
   */
  const TETO = 3;

  const dados = JSON.parse(
    document.getElementById("cl-dados")?.textContent ?? "[]",
  ) as Record<string, string>[];

  const painel = document.getElementById("cl-comparador");
  const tabela = document.getElementById("cl-tabela");
  const limpar = document.getElementById("cl-limpar");
  const caixas = Array.from(
    document.querySelectorAll<HTMLInputElement>("input[data-cmp]"),
  );

  if (painel && tabela && limpar && caixas.length) {
    // Ordem de marcação, não ordem da grade: quem entrou primeiro é quem sai.
    let escolhidas: string[] = [];

    const LINHAS = ["Armas", "Alcance", "Dificuldade", "Em uma frase"];

    function desenhar() {
      const sel = escolhidas
        .map((nome) => dados.find((d) => d.nome === nome))
        .filter((d): d is Record<string, string> => !!d);

      painel!.hidden = sel.length < 2;
      if (sel.length < 2) return;

      const cabecalho = document.createElement("tr");
      cabecalho.append(document.createElement("th"));
      for (const c of sel) {
        const th = document.createElement("th");
        const link = document.createElement("a");
        link.href = c.href;
        link.textContent = c.nome;
        th.append(link);
        cabecalho.append(th);
      }
      const thead = document.createElement("thead");
      thead.append(cabecalho);

      const tbody = document.createElement("tbody");
      for (const campo of LINHAS) {
        const tr = document.createElement("tr");
        const rotulo = document.createElement("th");
        rotulo.scope = "row";
        rotulo.textContent = campo;
        tr.append(rotulo);
        for (const c of sel) {
          const td = document.createElement("td");
          td.textContent = c[campo] ?? "—";
          tr.append(td);
        }
        tbody.append(tr);
      }

      tabela!.replaceChildren(thead, tbody);
    }

    for (const caixa of caixas) {
      caixa.addEventListener("change", () => {
        if (caixa.checked) {
          escolhidas.push(caixa.value);
          if (escolhidas.length > TETO) {
            const saiu = escolhidas.shift();
            const antiga = caixas.find((c) => c.value === saiu);
            if (antiga) antiga.checked = false;
          }
        } else {
          escolhidas = escolhidas.filter((n) => n !== caixa.value);
        }
        desenhar();
      });
    }

    limpar.addEventListener("click", () => {
      escolhidas = [];
      for (const caixa of caixas) caixa.checked = false;
      desenhar();
    });
  }
</script>
