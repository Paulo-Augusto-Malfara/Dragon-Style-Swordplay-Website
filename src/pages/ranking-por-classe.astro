---
import PageLayout from "../layouts/PageLayout.astro";
import { supabasePublic } from "../lib/supabase-public";
import RankingLista from "../components/RankingLista.astro";

export const prerender = false;

const { data } = await supabasePublic
  .from("v_ranking_por_classe")
  .select("*")
  .neq("id_classe", 11) // Básico is a veterano gate, not a rankable class
  .order("treinos_por_classe", { ascending: false });

// a faixa é por membro, não por classe, e v_ranking_por_classe não a carrega —
// mesmo padrão de Map que ranking-geral.astro usa pros totais por membro
const { data: faixas } = await supabasePublic
  .from("v_ranking_nivel_geral")
  .select("id_membro, nome_faixa");
const faixaPorMembro = new Map<number, string | null>(
  (faixas ?? []).map((f) => [f.id_membro, f.nome_faixa])
);

const porClasse = new Map<string, typeof data>();
for (const row of data ?? []) {
  if (!porClasse.has(row.nome_classe)) porClasse.set(row.nome_classe, []);
  porClasse.get(row.nome_classe)!.push(row);
}

const classes = [...porClasse.entries()].sort(([a], [b]) => a.localeCompare(b));
const slug = (nome: string) => nome.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
---

<PageLayout
  title="Ranking por Classe"
  description="O ranking de cada uma das classes do Dragon Style, por treinos registrados."
  resumo="Cada classe tem o seu ranking, ordenado por treinos registrados. Toque em uma classe para pular direto pra ela."
>
  <nav class="ranking-quick-nav">
    {classes.map(([nomeClasse]) => (
      <a href={`#classe-${slug(nomeClasse)}`} class="btn btn-sm">{nomeClasse}</a>
    ))}
  </nav>
  {
    classes.map(([nomeClasse, rows]) => (
      <section class="ranking-classe" id={`classe-${slug(nomeClasse)}`}>
        <h2>{nomeClasse}</h2>
        <RankingLista
          colunas={2}
          itens={rows!.map((m, i) => ({
            posicao: i + 1,
            nome: m.nome,
            fotoUrl: m.foto_url,
            nomeFaixa: faixaPorMembro.get(m.id_membro),
            metricas: [
              { rotulo: "Nível", valor: m.nivel_por_classe },
              { rotulo: "Treinos", valor: m.treinos_por_classe },
            ],
          }))}
        />
      </section>
    ))
  }
</PageLayout>
