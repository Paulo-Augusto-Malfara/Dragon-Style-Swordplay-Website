---
import PageLayout from "../layouts/PageLayout.astro";
import { supabasePublic } from "../lib/supabase-public";
import { corDaFaixa } from "../lib/faixa";

export const prerender = false;

const { data } = await supabasePublic
  .from("v_ranking_por_classe")
  .select("*")
  .neq("id_classe", 11) // Básico is a veterano gate, not a rankable class
  .order("treinos_por_classe", { ascending: false });

// a faixa é por membro, não por classe, e v_ranking_por_classe não a carrega —
// mesmo padrão de Map que ranking-geral.astro usa pros totais por membro
const { data: faixas } = await supabasePublic
  .from("v_ranking_nivel_geral")
  .select("id_membro, nome_faixa");
const faixaPorMembro = new Map<number, string | null>(
  (faixas ?? []).map((f) => [f.id_membro, f.nome_faixa])
);

const porClasse = new Map<string, typeof data>();
for (const row of data ?? []) {
  if (!porClasse.has(row.nome_classe)) porClasse.set(row.nome_classe, []);
  porClasse.get(row.nome_classe)!.push(row);
}

const classes = [...porClasse.entries()].sort(([a], [b]) => a.localeCompare(b));
const slug = (nome: string) => nome.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
---

<PageLayout
  title="Ranking por Classe"
>
  <section>
    <p>
      Clique no nome de uma classe para ver o ranking dela, ordenado pelo
      número de treinos registrados.
    </p>
    <br />
  </section>
  <nav class="ranking-quick-nav">
    {classes.map(([nomeClasse]) => (
      <a href={`#classe-${slug(nomeClasse)}`} class="btn btn-sm">{nomeClasse}</a>
    ))}
  </nav>
  {
    classes.map(([nomeClasse, rows]) => (
      <section class="ranking-classe" id={`classe-${slug(nomeClasse)}`}>
        <h2>{nomeClasse}</h2>
        <div class="table-scroll">
          <table class="ranking-tabela ranking-tabela--classe">
            <thead>
              <tr>
                <th class="col-rank">#</th>
                <th class="col-nome">Nome</th>
                <th class="col-stat">Nível</th>
                <th class="col-stat">Treinos</th>
              </tr>
            </thead>
            <tbody>
              {rows!.map((m, i) => (
                <tr class={i < 3 ? `rank-row rank-${i + 1}` : "rank-row"}>
                  <td class="col-rank">
                    <span class="rank-badge">{i + 1}</span>
                  </td>
                  <td class="col-nome">
                    {corDaFaixa(faixaPorMembro.get(m.id_membro)) && (
                      <span
                        class="faixa-bar faixa-bar--linha"
                        style={`--faixa: ${corDaFaixa(faixaPorMembro.get(m.id_membro))}`}
                        title={`Faixa ${faixaPorMembro.get(m.id_membro)}`}
                      >
                        <span class="sr-only">Faixa {faixaPorMembro.get(m.id_membro)}</span>
                      </span>
                    )}
                    <span class="row-avatar">
                      {m.foto_url ? <img src={m.foto_url} alt="" /> : m.nome.charAt(0).toUpperCase()}
                    </span>
                    <span class="row-name">{m.nome}</span>
                  </td>
                  <td class="col-stat">
                    <span class="stat-pill">{m.nivel_por_classe}</span>
                  </td>
                  <td class="col-stat">
                    <span class="stat-pill">{m.treinos_por_classe}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }
</PageLayout>
