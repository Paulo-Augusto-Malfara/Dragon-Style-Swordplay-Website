---
import PageLayout from "../layouts/PageLayout.astro";
import { supabasePublic } from "../lib/supabase-public";
import RankingLista from "../components/RankingLista.astro";

export const prerender = false;

const { data } = await supabasePublic
  .from("v_ranking_por_classe")
  .select("*")
  .neq("id_classe", 11) // Básico is a veterano gate, not a rankable class
  .order("treinos_por_classe", { ascending: false });

// a faixa é por membro, não por classe, e v_ranking_por_classe não a carrega —
// mesmo padrão de Map que ranking-geral.astro usa pros totais por membro
const { data: faixas } = await supabasePublic
  .from("v_ranking_nivel_geral")
  .select("id_membro, nome_faixa");
const faixaPorMembro = new Map<number, string | null>(
  (faixas ?? []).map((f) => [f.id_membro, f.nome_faixa])
);

const porClasse = new Map<string, typeof data>();
for (const row of data ?? []) {
  if (!porClasse.has(row.nome_classe)) porClasse.set(row.nome_classe, []);
  porClasse.get(row.nome_classe)!.push(row);
}

const classes = [...porClasse.entries()].sort(([a], [b]) => a.localeCompare(b));
const slug = (nome: string) => nome.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

// Uma classe por vez, escolhida pela URL, no mesmo padrão do ?sort= do Ranking
// Geral. Antes as dez seções vinham todas no HTML e o CSS escondia nove com
// :target: clicar num botão trocava qual seção existia na página e o navegador
// tentava rolar até uma âncora cuja posição só passava a existir depois dessa
// troca. Daí a rolagem estranha, e daí a página em branco antes do primeiro
// clique, quando não havia âncora nenhuma pra casar.
const pedida = Astro.url.searchParams.get("classe");
const atual = classes.find(([nome]) => slug(nome) === pedida) ?? classes[0];
---

<PageLayout
  title="Ranking por Classe"
  description="O ranking de cada uma das classes do Dragon Style, por treinos registrados."
  resumo="Cada classe tem o seu ranking, ordenado por treinos registrados. Escolha a classe que quer ver."
>
  <nav class="chips" aria-label="Escolher a classe">
    {classes.map(([nomeClasse]) => (
      <a
        href={`?classe=${slug(nomeClasse)}`}
        class:list={["chip", nomeClasse === atual?.[0] && "ativo"]}
        aria-current={nomeClasse === atual?.[0] ? "page" : undefined}
      >
        {nomeClasse}
      </a>
    ))}
  </nav>

  {
    atual ? (
      <section class="ranking-classe">
        <h2>{atual[0]}</h2>
        <p class="rk-conta">
          {atual[1]!.length} {atual[1]!.length === 1 ? "membro" : "membros"} com treino
          registrado nesta classe
        </p>
        <RankingLista
          colunas={2}
          itens={atual[1]!.map((m, i) => ({
            posicao: i + 1,
            idMembro: m.id_membro,
            nome: m.nome,
            fotoUrl: m.foto_url,
            nomeFaixa: faixaPorMembro.get(m.id_membro),
            metricas: [
              { rotulo: "Nível", valor: m.nivel_por_classe },
              { rotulo: "Treinos", valor: m.treinos_por_classe },
            ],
          }))}
        />
      </section>
    ) : (
      <p class="vazio">
        Nenhum treino registrado ainda. Assim que o primeiro treino for fechado, os
        rankings de classe aparecem aqui.
      </p>
    )
  }
</PageLayout>

<style>
  .rk-conta {
    margin: -0.4em 0 1em;
    font-size: 0.82rem;
    color: var(--ds-text-5);
  }
</style>
