---
import { getEntry, render } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import SumarioPagina from "../components/SumarioPagina.astro";

const entry = await getEntry("sobreNos", "quem-somos");
const { Content, headings } = await render(entry);
---

<PageLayout
  title={entry.data.title}
  resumo="Um grupo sem fins lucrativos de São José do Rio Preto, treinando Swordplay na Praça do Vivendas desde 2009."
>
  <SumarioPagina {headings} />
  <section class="prosa">
    <Content />
  </section>
</PageLayout>
