---
import BaseLayout from "./BaseLayout.astro";
import { grupoDe } from "../lib/navegacao";

interface Props {
  title: string;
  description?: string;
  /** Uma frase de abertura. Aparece maior que o corpo, logo abaixo do título. */
  resumo?: string;
}
const { title, description, resumo } = Astro.props;

// O rótulo diz em que seção do manual você está. Sai da mesma lista que monta o
// menu, então nunca discorda dele.
const grupo = grupoDe(Astro.url.pathname);
---

<BaseLayout title={title} description={description}>
  {/* `pagina-conteudo` separa página de leitura do painel: o AdminShell usa a
      mesma `.pagina`, e a regra de título centralizado é só pra cá. */}
  <div class="pagina pagina-conteudo">
    <header class="pagina-cab">
      {grupo && <p class="eyebrow">{grupo}</p>}
      <h1>{title}</h1>
      {resumo && <p class="pagina-resumo">{resumo}</p>}
    </header>
    <slot />
  </div>
</BaseLayout>
