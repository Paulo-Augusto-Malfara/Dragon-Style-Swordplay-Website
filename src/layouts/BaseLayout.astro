---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NavMenu from "../components/NavMenu.astro";
import BottomNav from "../components/BottomNav.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Site do grupo Dragon Style Swordplay e Eventos." } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/assets/img/og-image.webp", Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <!-- viewport-fit=cover é obrigatório pro env(safe-area-inset-*) devolver
         valor diferente de zero no iPhone; sem ele o dock inferior fica por
         baixo da barra de gestos. O topo segue protegido porque a status bar
         está em "black" (opaca), não "black-translucent". -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="shortcut icon" href="/assets/img/favIcon (2).ico" />
    <meta name="description" content={description} />

    <!-- PWA. O dock inferior já trata safe-area-inset-bottom, mas o topo não,
         então status-bar-style segue em "black" (opaca): "black-translucent"
         jogaria o cabeçalho pra debaixo do relógio no iPhone. Só vale trocar
         quando o cabeçalho também respeitar safe-area-inset-top. -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0B1016" />
    <link rel="apple-touch-icon" href="/pwa/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Dragon Style" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <script src="/sw-register.js" defer is:inline></script>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <title>{title} - Dragon Style Swordplay e Eventos</title>
  </head>
  <body>
    <header>
      <Header />
    </header>
    <!-- A lateral e o conteúdo dividem uma linha no desktop. No celular .shell
         volta a ser block e a mesma <nav> vira a gaveta que o dock abre, então
         ela precisa continuar no DOM em qualquer largura. -->
    <div class="shell">
      <aside class="lateral">
        <NavMenu />
      </aside>
      <main>
        <slot />
      </main>
    </div>
    <footer>
      <Footer />
    </footer>
    <BottomNav />
  </body>
</html>
