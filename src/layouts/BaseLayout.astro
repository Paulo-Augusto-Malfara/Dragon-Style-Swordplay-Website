---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NavMenu from "../components/NavMenu.astro";
import BottomNav from "../components/BottomNav.astro";
import BuscaGlobal from "../components/BuscaGlobal.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Site do grupo Dragon Style Swordplay e Eventos." } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/assets/img/og-image.webp", Astro.site);

/* Transição de página no site público, e só nele.
 *
 * O admin fica de fora de propósito. O ClientRouter troca o corpo do documento
 * sem recarregar a página, e as ilhas Svelte de lá guardam coisa que precisa
 * ser desfeita na saída: o TreinoAtivo mantém um canal de Realtime aberto e
 * conta com onDestroy pra fechá-lo. Trocar o DOM por baixo dele arriscaria
 * canal vazado e assinatura duplicada bem na tela em que três organizadores
 * lançam presença ao mesmo tempo. O admin é ferramenta de trabalho, e ali
 * confiabilidade vale mais que a transição.
 *
 * Quando o destino não tem ClientRouter, o Astro faz a navegação completa de
 * sempre, então entrar e sair do admin continua funcionando sem nada especial.
 */
const comTransicao = !/^\/(admin|auth)(\/|$)/.test(Astro.url.pathname);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <!-- viewport-fit=cover é obrigatório pro env(safe-area-inset-*) devolver
         valor diferente de zero no iPhone; sem ele o dock inferior fica por
         baixo da barra de gestos. O topo segue protegido porque a status bar
         está em "black" (opaca), não "black-translucent". -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="shortcut icon" href="/assets/img/favIcon (2).ico" />
    <meta name="description" content={description} />

    <!-- PWA. O dock inferior já trata safe-area-inset-bottom, mas o topo não,
         então status-bar-style segue em "black" (opaca): "black-translucent"
         jogaria o cabeçalho pra debaixo do relógio no iPhone. Só vale trocar
         quando o cabeçalho também respeitar safe-area-inset-top. -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0B1016" />
    <link rel="apple-touch-icon" href="/pwa/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Dragon Style" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <script src="/sw-register.js" defer is:inline></script>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <title>{title} - Dragon Style Swordplay e Eventos</title>
    {comTransicao && <ClientRouter />}
  </head>
  <body>
    {/*
      transition:persist mantém ESTE elemento entre as páginas em vez de
      trocá-lo por um igual. Sem isso o cabeçalho entra na troca de corpo do
      ClientRouter e pisca a cada navegação, mesmo desenhando exatamente o
      mesmo pixel: logo, busca e avatar são refeitos do zero toda vez.

      Só o cabeçalho. O dock de baixo e a lateral marcam a página atual, e um
      elemento persistido não é redesenhado: o destaque congelaria na página
      onde a pessoa entrou.
    */}
    <header transition:persist>
      <Header />
    </header>
    <!-- A lateral e o conteúdo dividem uma linha no desktop. No celular .shell
         volta a ser block e a mesma <nav> vira a gaveta que o dock abre, então
         ela precisa continuar no DOM em qualquer largura. -->
    <div class="shell">
      <aside class="lateral">
        <NavMenu />
      </aside>
      <main>
        <slot />
      </main>
    </div>
    <footer>
      <Footer />
    </footer>
    <BottomNav />
    <BuscaGlobal />
  </body>
</html>
