---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NavMenu from "../components/NavMenu.astro";
import BottomNav from "../components/BottomNav.astro";
import BuscaGlobal from "../components/BuscaGlobal.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Site do grupo Dragon Style Swordplay e Eventos." } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/assets/img/og-image.webp", Astro.site);

/* Transição de página no site público, e só nele.
 *
 * O admin fica de fora de propósito. O ClientRouter troca o corpo do documento
 * sem recarregar a página, e as ilhas Svelte de lá guardam coisa que precisa
 * ser desfeita na saída: o TreinoAtivo mantém um canal de Realtime aberto e
 * conta com onDestroy pra fechá-lo. Trocar o DOM por baixo dele arriscaria
 * canal vazado e assinatura duplicada bem na tela em que três organizadores
 * lançam presença ao mesmo tempo. O admin é ferramenta de trabalho, e ali
 * confiabilidade vale mais que a transição.
 *
 * Quando o destino não tem ClientRouter, o Astro faz a navegação completa de
 * sempre, então entrar e sair do admin continua funcionando sem nada especial.
 */
const comTransicao = !/^\/(admin|auth)(\/|$)/.test(Astro.url.pathname);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <!-- viewport-fit=cover é obrigatório pro env(safe-area-inset-*) devolver
         valor diferente de zero no iPhone; sem ele o dock inferior fica por
         baixo da barra de gestos. O topo segue protegido porque a status bar
         está em "black" (opaca), não "black-translucent". -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="shortcut icon" href="/assets/img/favIcon (2).ico" />
    <meta name="description" content={description} />

    <!-- PWA. O dock inferior já trata safe-area-inset-bottom, mas o topo não,
         então status-bar-style segue em "black" (opaca): "black-translucent"
         jogaria o cabeçalho pra debaixo do relógio no iPhone. Só vale trocar
         quando o cabeçalho também respeitar safe-area-inset-top. -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0B1016" />
    <link rel="apple-touch-icon" href="/pwa/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Dragon Style" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <script src="/sw-register.js" defer is:inline></script>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <title>{title} - Dragon Style Swordplay e Eventos</title>
    {comTransicao && <ClientRouter />}
  </head>
  <body>
    {/*
      transition:persist mantém ESTE elemento entre as páginas em vez de
      trocá-lo por um igual. Sem isso o cabeçalho entra na troca de corpo do
      ClientRouter e pisca a cada navegação, mesmo desenhando exatamente o
      mesmo pixel: logo, busca e avatar são refeitos do zero toda vez.

      Só o cabeçalho. O dock de baixo e a lateral marcam a página atual, e um
      elemento persistido não é redesenhado: o destaque congelaria na página
      onde a pessoa entrou.
    */}
    <header transition:persist>
      <Header />
    </header>
    <!-- A lateral e o conteúdo dividem uma linha no desktop. No celular .shell
         volta a ser block e a mesma <nav> vira a gaveta que o dock abre, então
         ela precisa continuar no DOM em qualquer largura. -->
    <div class="shell">
      <aside class="lateral">
        <NavMenu />
      </aside>
      <main>
        <slot />
      </main>
    </div>
    <footer>
      <Footer />
    </footer>
    <BottomNav />
    <BuscaGlobal />
    <script>
  /**
   * As duas regras que valem pra toda janela do site.
   *
   * 1. O `#hash` da URL abre a janela correspondente. É isso que faz a busca
   *    global entregar o card certo em vez de largar a pessoa no catálogo: o
   *    resultado aponta pra /equipamentos#espada-media e a janela abre sozinha.
   *    De brinde, o card vira link compartilhável e o cartão do catálogo pode
   *    ser um <a href="#slug"> comum, sem script nenhum por página.
   *
   * 2. Clicar fora fecha. O <dialog> nativo não faz isso sozinho, e era a
   *    reclamação: só o X fechava.
   *
   * Mora aqui, e não em cada página, porque três catálogos já precisavam do
   * mesmo, e porque o listener de clique é delegado no document: ele sobrevive
   * à troca de corpo do ClientRouter, que substituiria qualquer listener preso
   * a um elemento da página.
   */
  function janelaDoHash() {
    const alvo = location.hash.slice(1);
    if (!alvo) return null;
    return document.querySelector<HTMLDialogElement>(
      `dialog[data-hash="${CSS.escape(alvo)}"]`,
    );
  }

  function sincronizarComHash() {
    const janela = janelaDoHash();
    // Fechar as outras é o que faz o botão "voltar" do celular fechar a janela:
    // ele desfaz o #hash, e sem isto a caixa continuaria aberta sobre a página.
    for (const aberta of document.querySelectorAll<HTMLDialogElement>(
      "dialog[data-hash][open]",
    )) {
      if (aberta !== janela) aberta.close();
    }
    if (janela && !janela.open) janela.showModal();
  }

  sincronizarComHash();
  // hashchange cobre chegar de fora com o link pronto; astro:page-load cobre a
  // navegação do ClientRouter, que não recarrega o módulo; popstate cobre o
  // voltar do navegador.
  addEventListener("hashchange", sincronizarComHash);
  addEventListener("popstate", sincronizarComHash);
  document.addEventListener("astro:page-load", sincronizarComHash);

  /* O clique no card, tratado à mão.
   *
   * Um <a href="#slug"> comum não basta com o ClientRouter no ar: ele
   * intercepta o clique e troca a URL por history.pushState, e pushState NÃO
   * dispara hashchange. O hash aparecia na barra de endereço e a janela não
   * abria. Fase de captura porque é a única forma garantida de rodar antes do
   * listener do ClientRouter, que desiste ao ver o defaultPrevented.
   *
   * Só intercepta âncora que aponta pra uma janela: o sumário das páginas e
   * qualquer outro link com # continuam rolando como sempre.
   */
  document.addEventListener(
    "click",
    (evento) => {
      const link = (evento.target as HTMLElement | null)?.closest?.("a[href^='#']");
      const destino = link?.getAttribute("href")?.slice(1);
      if (!destino) return;
      const janela = document.querySelector<HTMLDialogElement>(
        `dialog[data-hash="${CSS.escape(destino)}"]`,
      );
      if (!janela) return;
      evento.preventDefault();
      // O pushState é o que faz o voltar do celular fechar a janela.
      history.pushState(null, "", `#${destino}`);
      sincronizarComHash();
    },
    true,
  );

  document.addEventListener("click", (evento) => {
    const janela = evento.target;
    if (!(janela instanceof HTMLDialogElement) || !janela.open) return;
    // O alvo do clique também é o <dialog> quando se acerta o padding dele, e
    // aí a caixa não pode fechar. Só fecha fora do retângulo, que é o backdrop.
    const r = janela.getBoundingClientRect();
    const fora =
      evento.clientX < r.left ||
      evento.clientX > r.right ||
      evento.clientY < r.top ||
      evento.clientY > r.bottom;
    if (fora) janela.close();
  });

  // Fechou: o hash tem que sair da URL, senão clicar no MESMO card de novo não
  // muda o hash, não dispara hashchange e a janela nunca mais abre.
  // `close` não borbulha, por isso a fase de captura.
  document.addEventListener(
    "close",
    (evento) => {
      const janela = evento.target as HTMLDialogElement;
      if (janela.dataset?.hash && location.hash.slice(1) === janela.dataset.hash) {
        history.replaceState(null, "", location.pathname + location.search);
      }
    },
    true,
  );
  </script>
  </body>
</html>
